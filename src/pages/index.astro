</style>

<script>
  // Bandeira tarifária: quando a régua da ANEEL aparece na tela, a bandeira
  // passa sozinha, devagar, de verde a vermelha 2 (um degrau a cada PASSO_MS)
  // e para na vermelha 2, o estado que o texto descreve. Se a régua sai
  // inteira da tela, volta ao verde para tocar de novo na próxima vez.
  // Sem JS ou com movimento reduzido, fica parada na vermelha 2.
  const bandeira = document.querySelector<HTMLElement>(".secao--bandeira");
  const tarifa = bandeira?.querySelector<HTMLElement>(".tarifa__passos");
  if (bandeira && tarifa && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const PASSO_MS = 1800;
    let timers: number[] = [];
    const parar = () => { timers.forEach(clearTimeout); timers = []; };
    bandeira.dataset.bandeira = "0";
    new IntersectionObserver(([e]) => {
      if (e.intersectionRatio >= 0.6) {
        if (timers.length || bandeira.dataset.bandeira === "3") return;
        for (let p = 1; p <= 3; p++) {
          timers.push(window.setTimeout(() => { bandeira.dataset.bandeira = String(p); }, PASSO_MS * p));
        }
      } else if (e.intersectionRatio === 0) {
        parar();
        bandeira.dataset.bandeira = "0";
      }
    }, { threshold: [0, 0.6] }).observe(tarifa);
  }
  // Selos: quando a seção de números aparece, os três são carimbados um a
  // um (o CSS faz o movimento). Sem JS ou com movimento reduzido, nada é
  // escondido: os selos já estão no lugar.
  const selosSecao = document.querySelector<HTMLElement>(".selos-secao");
  const selosLista = selosSecao?.querySelector<HTMLElement>(".selos");
  if (selosSecao && selosLista && "IntersectionObserver" in window &&
      matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    selosSecao.dataset.carimbo = "espera";
    const obs = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      selosSecao.dataset.carimbo = "feito";
      obs.disconnect();
    }, { threshold: 0.25 });
    obs.observe(selosLista);
  }
</script>
