---
import Vertical from "../layouts/Vertical.astro";
import { COOPLUZ } from "../data/solucoes";
import Fatura from "../components/Fatura.astro";

const solucao = COOPLUZ;

const perguntas = [
  {
    p: "Preciso instalar placa solar no meu telhado?",
    r: "Não. A energia é gerada em fazendas solares cooperadas à Coopluz. Você recebe os créditos dessa geração abatidos na sua fatura — nada é instalado, nada é construído no seu imóvel.",
  },
  {
    p: "Vou trocar de distribuidora?",
    r: "Não. A Equatorial Goiás continua sendo sua distribuidora, a fatura continua vindo dela e a titularidade da conta permanece no seu nome. O que muda é o valor: os créditos de compensação entram como desconto.",
  },
  {
    p: "Quem pode participar?",
    r: "Residências, comércios e pequenas indústrias atendidos pela Equatorial Goiás com consumo médio acima de R$ 250 por mês. Abaixo desse valor o cadastro segue para análise da Coopluz, e a gente diz isso antes de você assinar.",
  },
  {
    p: "Em quanto tempo o desconto aparece na fatura?",
    r: "A aprovação do cadastro sai rápido. Já o primeiro crédito na fatura costuma aparecer em até 90 dias, porque depende do ciclo de leitura da distribuidora e do processo de vinculação da unidade consumidora à cooperativa.",
  },
  {
    p: "Meu nome está negativado. Posso participar?",
    r: "Pode. A adesão à Coopluz não passa por consulta ao SPC ou ao Serasa e não há análise de crédito: você não está contratando financiamento nem comprando equipamento, só recebendo créditos de energia na fatura que já é sua. O que impede a adesão é a conta estar em nome de outra pessoa, ter Tarifa Social ou isenção de ICMS de produtor rural, ou estar com irregularidade junto à distribuidora.",
  },
  {
    p: "Tem taxa de adesão, fidelidade ou multa para sair?",
    r: "Não há taxa de adesão nem multa de cancelamento. Ao sair, você paga apenas o saldo residual dos créditos já utilizados e não faturados.",
  },
  {
    p: "E se eu mudar de endereço?",
    r: "A participação pode ser transferida para o novo imóvel, desde que ele fique dentro da mesma área de concessão da distribuidora.",
  },
  {
    p: "Isso é legal?",
    r: "Sim. O sistema de compensação de energia elétrica é regulado pela ANEEL e amparado pela Lei 14.300/2022, que instituiu o marco legal da microgeração e minigeração distribuída no Brasil.",
  },
];
---

<Vertical
  solucao={solucao}
  h1="Pague 20% menos na conta da Equatorial Goiás, sem obra e sem placa no telhado"
  chamada="A Coopluz é uma cooperativa de energia por compensação. Você se torna cooperado, recebe créditos de fazendas solares cooperadas e o desconto entra direto na sua fatura. Sem instalar nada, sem trocar de distribuidora e sem taxa de adesão."
  perguntas={perguntas}
  tituloForm="Receba a análise da sua conta"
  rotuloBarra="Ver meu desconto"
>
  {/* A seção é a bandeira tarifária: o fundo passa por verde, amarela, vermelha 1
       e vermelha 2 enquanto ela atravessa a tela. Sem JS fica na vermelha 2 —
       o estado que o texto descreve. */}
  <section class="secao secao--bandeira" data-bandeira="3">
    <div class="container">
      <div class="bandeira__linha">
        <div class="bandeira" aria-hidden="true">
          <span class="bandeira__mastro"></span>
          <div class="bandeira__pano">
            <strong data-passo="0">Verde<small>sem cobrança extra</small></strong>
            <strong data-passo="1">Amarela<small>mais caro</small></strong>
            <strong data-passo="2">Vermelha 1<small>mais caro ainda</small></strong>
            <strong data-passo="3">Vermelha 2<small>a mais cara</small></strong>
          </div>
        </div>
        <div>
          <span class="olho">O problema</span>
          <h2>A conta de luz subiu e não tem como consumir menos</h2>
          <p class="chamada">
            Bandeira tarifária, reajuste anual e o calor de Goiás fizeram da luz uma das três maiores despesas fixas do
            mês. O que subiu foi o preço do kWh, não o seu uso — por isso apagar a luz não resolve.
          </p>
        </div>
      </div>
      {/* Régua da ANEEL: quanto cada bandeira soma por 100 kWh (R$/kWh da
           tabela oficial × 100, arredondado). Fonte: gov.br/aneel, página
           "Sobre Bandeiras Tarifárias", atualizada em 08/01/2026. */}
      <div class="tarifa">
        <div class="tarifa__titulo">
          <p id="tarifa-titulo">Quanto cada bandeira soma na sua conta, a cada 100 kWh</p>
          <small>
            Fonte:
            <a href="https://www.gov.br/aneel/pt-br/assuntos/tarifas/bandeiras-tarifarias" rel="noopener" target="_blank">ANEEL</a>,
            valores de 2026, antes dos impostos
          </small>
        </div>
        <ol class="tarifa__passos" role="list" aria-labelledby="tarifa-titulo">
          <li data-passo="0"><span>Verde</span><strong>R$ 0</strong><em>sem cobrança extra</em></li>
          <li data-passo="1"><span>Amarela</span><strong>+ R$ 1,89</strong><em>mais caro</em></li>
          <li data-passo="2"><span>Vermelha 1</span><strong>+ R$ 4,46</strong><em>mais caro ainda</em></li>
          <li data-passo="3"><span>Vermelha 2</span><strong>+ R$ 7,88</strong><em>a mais cara</em></li>
        </ol>
      </div>
      <div class="bandeira__saidas">
        <p class="bandeira__antes">
          <span>A saída conhecida</span>
          Placa solar no próprio telhado: obra, projeto e anos até o investimento voltar.
        </p>
        <p class="bandeira__agora">
          <span>Com a Coopluz</span>
          Você usa a energia de uma fazenda solar da cooperativa. Sem obra e sem investimento.
        </p>
      </div>
    </div>
  </section>

  <Fatura />

  <section class="secao">
    <div class="container">
      <span class="olho">Quem pode participar</span>
      <h2>Consumo acima de R$ 250 por mês, em Goiás</h2>
      <div class="grade grade--2">
        <div class="cartao">
          <h3>Serve para você se…</h3>
          <ul class="lista-check" role="list">
            <li>Seu imóvel é atendido pela Equatorial Goiás</li>
            <li>A conta média passa de R$ 250 por mês</li>
            <li>É residência, comércio, condomínio ou pequena indústria</li>
            <li>Você quer economia sem imobilizar capital</li>
            <li>Seu nome está negativado — não há consulta ao SPC ou Serasa</li>
          </ul>
        </div>
        <div class="cartao">
          <h3>Ainda não serve se…</h3>
          <ul class="lista-limpa fora" role="list">
            <li>O imóvel fica fora da área da Equatorial Goiás</li>
            <li>Você já tem geração própria compensando 100% do consumo</li>
          </ul>
          <p class="nota">
            Conta média abaixo de R$ 250? Ainda dá para pedir — o cadastro segue para análise da Coopluz em vez de
            aprovação direta, e a gente diz isso na primeira conversa, antes de qualquer assinatura.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao--suave">
    <div class="container">
      <span class="olho">Números da cooperativa</span>
      <h2>De 380 para 3.865 cooperados em quatro meses</h2>
      {/* Grade própria, e não a `beneficios__grade` do herói: aqui o número
           É o argumento. Reusar o cartão de benefício deixava "3.865" no mesmo
           corpo de um rótulo de card, e o dado que sustenta a página inteira
           passava despercebido. A unidade sai do número e vira linha de baixo,
           para o algarismo ficar sozinho na primeira linha. */}
      <ul class="numeros" role="list">
        <li>
          <strong>3.865</strong>
          <b>cooperados</b>
          <span>recebendo crédito hoje, em Goiás</span>
        </li>
        <li>
          <strong>10&times;</strong>
          <b>em quatro meses</b>
          <span>crescimento de dez/25 a mar/26</span>
        </li>
        <li>
          <strong>1,66 mi</strong>
          <b>kWh compensados</b>
          <span>no mês de março/2026</span>
        </li>
      </ul>
      <p class="nota">
        Posição de março/2026, conforme relatório da Coopluz — 180 t de CO₂ evitadas, equivalente a 720 árvores
        plantadas. A cooperativa segue crescendo mês a mês.
      </p>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <span class="olho">Na mídia</span>
      <h2>Energia por assinatura também virou notícia</h2>
      <p class="chamada">
        Antes deste site, o modelo de compensação por assinatura já tinha passado pela Jovem Pan News e pela Rede
        Globo — sem a Coopluz pagar pelo espaço.
      </p>
      <ul class="imprensa lista-limpa" role="list">
        <li>
          <a
            class="imprensa__item externo"
            href="https://www.youtube.com/watch?v=AajbB7OHUR0"
            target="_blank"
            rel="noopener"
            data-ima
          >
            <span class="imprensa__veiculo">Jovem Pan News</span>
            <span class="imprensa__manchete">Brasileiro já pode assinar luz em casa ou comércio</span>
            <span class="imprensa__legenda">Fonte solar pode garantir desconto de 15% ao consumidor</span>
          </a>
        </li>
        <li>
          <a
            class="imprensa__item externo"
            href="https://www.youtube.com/watch?v=_pZob1Y9smI"
            target="_blank"
            rel="noopener"
            data-ima
          >
            <span class="imprensa__veiculo">Rede Globo</span>
            <span class="imprensa__manchete">Energia solar por assinatura: entenda como funciona</span>
            <span class="imprensa__legenda">Cobertura sobre economizar na conta de luz sem instalar placa</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <span class="olho">Leia mais</span>
      <h2>Entenda a conta de luz antes de decidir</h2>
      <ul class="lista-limpa" role="list">
        <li><a href="/blog/reduzir-conta-equatorial-sem-placa-solar">Como reduzir a conta da Equatorial Goiás sem instalar placa solar</a></li>
        <li><a href="/blog/fio-b-60-por-cento-2026-conta-equatorial-goias">Fio B a 60% em 2026: por que a conta da Equatorial Goiás subiu</a></li>
      </ul>
    </div>
  </section>
  <section class="secao secao--suave">
    <div class="container">
      <span class="olho">Quem está por trás</span>
      <h2>Uma cooperativa de energia, uma de crédito e um representante autorizado</h2>
      <p class="chamada">
        A Coopluz é uma cooperativa independente com sede em Goiânia e opera em parceria com o Sicoob Secovicred.
        A Autogestor é representante autorizado: é com a gente que você fala e é a Coopluz que emite o
        termo de adesão. Nenhuma das três consulta SPC ou Serasa para o seu cadastro.
      </p>
      <p class="chamada">
        No material institucional da própria Coopluz, a Autogestor aparece listada como Representante Autorizado,
        ao lado do Sicoob Nova Central e do Sicoob Secovicred — não é só o que a gente diz sobre si.
      </p>
      <ul class="marcas lista-limpa" role="list">
        {/* O lockup OFICIAL da cooperativa vive só aqui: é atribuição de
             terceiro, não a marca do site. A marca do site é o símbolo do
             cabeçalho — misturar os dois é justamente o que FR-015 proíbe.
             Arquivo atualizado a partir do material de abril/2026; o que
             estava no repositório era a geração anterior da marca. */}
        <li><img src="/img/parceiros/coopluz.png" width="712" height="266" alt="Coopluz" loading="lazy" decoding="async" /></li>
        <li><img src="/img/parceiros/sicoob.png" width="254" height="86" alt="Sicoob Secovicred" loading="lazy" decoding="async" /></li>
        <li class="marcas__nos">
          <img src="/img/parceiros/autogestor.svg" width="44" height="44" alt="" loading="lazy" decoding="async" />
          <span>Autogestor<small>Representante autorizado</small></span>
        </li>
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <span class="olho">Do outro lado do balcão</span>
      <h2>Dá para ganhar com a Coopluz, e não só economizar</h2>
      <p class="chamada">
        Se você tem rede de contatos em Goiás, a Autogestor credencia parceiros para apresentar essa mesma economia:
        comissão na ativação de cada conta e renda recorrente sobre a carteira — o suficiente, com carteira formada,
        para zerar a própria conta de luz de quem indica. Sem investimento e com treinamento gratuito.{" "}
        <a href="/parceiro">Veja como funciona o programa de parceiros da energia</a>.
      </p>
    </div>
  </section>
</Vertical>

<style>
  /* art-direction · ímã · eixos: geometria/ponteiro/clara · orçamento: ~1kb JS · 2026-08-22
     Prova social de imprensa (Jovem Pan, Globo). Matéria geometria — os cartões
     são tipo puro, sem foto: os vídeos de origem carregam bumper e marca da
     própria emissora, reusar o frame seria reexibir a marca deles como se
     fosse nossa. A citação (veículo + manchete + link para o original) é o
     que se pode reaproveitar sem isso. Card inteiro é o link (G27: nada some
     sem JS, só o deslocamento é enriquecimento) e reage à aproximação do
     cursor com o mesmo --ease-mola que já existe no arquivo — sem token novo. */
  .imprensa {
    display: grid;
    gap: var(--e-4);
    margin-top: var(--e-6);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .imprensa__item {
    display: block;
    background: var(--superficie-alta);
    border: 1px solid var(--borda);
    border-radius: var(--r-3);
    padding: var(--e-6);
    text-decoration: none;
    color: inherit;
  }
  .imprensa__veiculo {
    display: block;
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--marca);
    margin-bottom: var(--e-2);
  }
  .imprensa__manchete {
    display: block;
    font-family: var(--display);
    font-size: var(--t-md);
    font-variation-settings: "wght" 700;
    color: var(--texto);
    letter-spacing: -0.01em;
  }
  .imprensa__item:hover .imprensa__manchete { color: var(--marca-forte); }
  .imprensa__legenda {
    display: block;
    margin-top: var(--e-2);
    font-size: var(--t-sm);
    color: var(--texto-suave);
  }
  /* Entrada e ímã usam a MESMA primitiva do resto do arquivo: `rotate`. A
     página já está no teto de 3 primitivas de movimento (rotate no selo e no
     cordão, opacity e scale no cone/fio/nó) — `translate` em pixels, como o
     catálogo de Ímã propõe, seria a 4ª. O gesto vira "apontar": o cartão
     inclina como agulha de bússola em direção ao cursor, em vez de deslizar. */
  .imprensa__item { rotate: 0deg; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .imprensa__item {
        animation: imprensa-entra var(--dur-cena) var(--ease-cena) both;
        animation-timeline: view();
        animation-range: entry 10% cover 30%;
      }
    }
  }
  @keyframes imprensa-entra { from { opacity: 0; rotate: -4deg; } }

  /* O bloco de prova. `--t-3xl` no algarismo (o mesmo corpo do H1) porque é
     a única seção da página em que o dado, e não a frase, é o argumento. */
  .numeros {
    list-style: none;
    margin: var(--e-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--e-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .numeros li {
    border-top: 3px solid var(--verde-500);
    padding-top: var(--e-4);
  }
  .numeros strong {
    display: block;
    font-family: var(--display);
    font-variation-settings: "wght" 800;
    font-size: var(--t-3xl);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--verde-700);
    /* Algarismo de largura fixa: sem isto, "3.865" e "1,66" desalinham entre
       si e a linha de números perde a leitura de tabela. */
    font-variant-numeric: tabular-nums;
  }
  .numeros b {
    display: block;
    margin-top: var(--e-2);
    font-size: var(--t-md);
    font-weight: 700;
  }
  .numeros span {
    display: block;
    margin-top: var(--e-1);
    font-size: var(--t-sm);
    color: var(--texto-suave);
  }

  /* art-direction · bandeira-regua · eixos: pigmento/scroll/escura · orçamento: ~0,4kb JS · 2026-10-03
     "O problema" como a bandeira tarifária da conta. O fundo é sempre escuro
     (nos dois temas do cordão, como a capa): as quatro cores da ANEEL vão no
     pano e no topo de cada degrau da régua, e o fundo é a mesma cor quase
     apagada, para o texto creme passar em todas. Folha de 03/10, opção A:
     a régua com o valor oficial de cada bandeira substitui a borda de 4 cores,
     e a saída da Coopluz vira o único cartão claro da seção. */
  .secao--bandeira {
    --bandeira-fundo: #3a0d10;
    --bandeira-pano: #b3202a;
    --b-verde: #23804a;
    --b-amarela: #c99a1c;
    --b-vermelha1: #c94a24;
    --b-vermelha2: #b3202a;
    --b-creme: #f6f3ea;
    --b-creme-suave: #d4dddb;
    --b-apagado: #c9c2b8;
    --b-tinta: #0b1f1c;
    --b-ambar: #f2c14e;
    --b-ambar-tinta: #6e5100;
    --b-linha: rgba(246, 243, 234, 0.18);
    --b-degrau: rgba(246, 243, 234, 0.05);
    --b-brilho: rgba(242, 193, 78, 0.4);
    background: var(--bandeira-fundo);
    color: var(--b-creme);
    transition: background-color 900ms var(--ease-cena);
  }
  .secao--bandeira[data-bandeira="0"] { --bandeira-fundo: #0f3d26; --bandeira-pano: var(--b-verde); }
  .secao--bandeira[data-bandeira="1"] { --bandeira-fundo: #3d300a; --bandeira-pano: var(--b-amarela); }
  .secao--bandeira[data-bandeira="2"] { --bandeira-fundo: #3f1a0e; --bandeira-pano: var(--b-vermelha1); }
  .secao--bandeira::before { display: none; }
  .secao--bandeira .olho { color: var(--b-creme); opacity: 0.85; }
  .secao--bandeira h2 { color: var(--b-creme); font-size: clamp(2rem, 1.3rem + 2.4vw, 2.75rem); }
  .secao--bandeira .chamada { color: var(--b-creme-suave); }

  .bandeira__linha {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--e-12);
    align-items: center;
  }
  .bandeira__linha h2 { margin-bottom: 0; }
  .bandeira__linha .chamada { margin: var(--e-3) 0 0; max-width: 58ch; }
  .bandeira { position: relative; width: 240px; height: 160px; }
  .bandeira__mastro {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 8px;
    border-radius: 4px;
    background: linear-gradient(#e9e4d6, #9a9483);
  }
  .bandeira__pano {
    position: absolute;
    left: 8px;
    top: 10px;
    width: 224px;
    height: 100px;
    display: grid;
    place-items: center;
    background: var(--bandeira-pano);
    clip-path: polygon(0 0, 100% 6%, 95% 50%, 100% 94%, 0 100%);
    transform-origin: left center;
    transition: background-color 900ms var(--ease-cena);
  }
  .bandeira__pano strong {
    grid-area: 1 / 1;
    font-family: var(--display);
    font-size: 1.625rem;
    line-height: 1.1;
    color: #fff;
    text-align: center;
    letter-spacing: -0.01em;
    opacity: 0;
    transition: opacity 400ms;
  }
  /* Branco sobre o amarelo dá 2.6:1; ali o texto vira tinta (6.6:1). */
  .bandeira__pano strong[data-passo="1"] { color: var(--b-tinta); }
  .bandeira__pano small { display: block; font-size: 0.8125rem; font-weight: 600; opacity: 0.9; }
  .secao--bandeira[data-bandeira="0"] .bandeira__pano [data-passo="0"],
  .secao--bandeira[data-bandeira="1"] .bandeira__pano [data-passo="1"],
  .secao--bandeira[data-bandeira="2"] .bandeira__pano [data-passo="2"],
  .secao--bandeira[data-bandeira="3"] .bandeira__pano [data-passo="3"] { opacity: 1; }

  /* A régua: um degrau por bandeira, a cor da ANEEL no topo. O degrau da
     bandeira atual acende; os outros ficam apagados, mas legíveis. */
  .tarifa { margin-top: var(--e-12); }
  .tarifa__titulo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--e-2) var(--e-4);
    margin-bottom: var(--e-3);
  }
  .tarifa__titulo p { margin: 0; font-weight: 600; color: var(--b-creme); }
  .tarifa__titulo small { font-size: 0.8125rem; color: var(--b-apagado); }
  .tarifa__titulo a { color: inherit; text-underline-offset: 2px; }
  .tarifa__passos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tarifa__passos li {
    padding: var(--e-4) var(--e-4) var(--e-6);
    border-top: 8px solid var(--cor);
    background: var(--b-degrau);
    color: var(--b-apagado);
    transition: background-color 700ms var(--ease-cena), color 700ms;
  }
  .tarifa__passos li:nth-child(1) { --cor: var(--b-verde); }
  .tarifa__passos li:nth-child(2) { --cor: var(--b-amarela); }
  .tarifa__passos li:nth-child(3) { --cor: var(--b-vermelha1); }
  .tarifa__passos li:nth-child(4) { --cor: var(--b-vermelha2); }
  .tarifa__passos span {
    display: block;
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .tarifa__passos strong {
    display: block;
    margin-top: var(--e-1);
    font-family: var(--display);
    font-size: 2.125rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variation-settings: "wght" 700;
    transform-origin: left bottom;
    transition: scale 700ms var(--ease-cena);
  }
  .tarifa__passos em { display: block; margin-top: var(--e-1); font-style: normal; font-size: var(--t-sm); }
  /* O degrau aceso ganha a cor da bandeira no fundo (misturada com o fundo
     da seção, para o creme continuar passando) e o número cresce. */
  .secao--bandeira[data-bandeira="0"] .tarifa__passos [data-passo="0"],
  .secao--bandeira[data-bandeira="1"] .tarifa__passos [data-passo="1"],
  .secao--bandeira[data-bandeira="2"] .tarifa__passos [data-passo="2"],
  .secao--bandeira[data-bandeira="3"] .tarifa__passos [data-passo="3"] {
    background: color-mix(in srgb, var(--cor) 38%, var(--bandeira-fundo));
    color: var(--b-creme);
  }
  .secao--bandeira[data-bandeira="0"] .tarifa__passos [data-passo="0"] strong,
  .secao--bandeira[data-bandeira="1"] .tarifa__passos [data-passo="1"] strong,
  .secao--bandeira[data-bandeira="2"] .tarifa__passos [data-passo="2"] strong,
  .secao--bandeira[data-bandeira="3"] .tarifa__passos [data-passo="3"] strong { scale: 1.25; }

  /* As duas saídas: a conhecida apagada, a da Coopluz o único cartão claro
     da seção, com o brilho âmbar da lâmpada da capa. */
  .bandeira__saidas {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--e-6);
    align-items: center;
    margin-top: var(--e-12);
  }
  .bandeira__saidas p { margin: 0; }
  .bandeira__saidas span {
    display: block;
    margin-bottom: var(--e-2);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .bandeira__antes { padding-top: var(--e-6); border-top: 1px solid var(--b-linha); color: var(--b-apagado); max-width: 46ch; }
  .bandeira__agora {
    padding: var(--e-6) var(--e-8);
    border-radius: var(--r-4);
    background: var(--b-creme);
    color: var(--b-tinta);
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.5;
    box-shadow: 0 24px 60px -20px var(--b-brilho);
  }
  .bandeira__agora span { color: var(--b-ambar-tinta); }

  /* O pano tremula só com `scale`, primitiva que a página já usa — nada de
     skew, que seria a quarta. */
  @keyframes bandeira-tremula { 50% { scale: 0.97 1.02; } }
  @media (prefers-reduced-motion: no-preference) {
    .bandeira__pano { animation: bandeira-tremula 3.2s ease-in-out infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .secao--bandeira, .bandeira__pano, .bandeira__pano strong,
    .tarifa__passos li, .tarifa__passos strong { transition: none; }
  }
  @media (max-width: 860px) {
    .bandeira__linha { grid-template-columns: 1fr; gap: var(--e-4); }
    .bandeira { width: 170px; height: 112px; }
    .bandeira__pano { width: 160px; height: 70px; }
    .bandeira__pano strong { font-size: 1.1875rem; }
    .bandeira__pano small { font-size: 0.75rem; }
    .tarifa { margin-top: var(--e-8); }
    .tarifa__passos { grid-template-columns: 1fr 1fr; }
    .tarifa__passos strong { font-size: 1.625rem; }
    .bandeira__saidas { grid-template-columns: 1fr; margin-top: var(--e-8); }
    .bandeira__agora { padding: var(--e-6); font-size: var(--t-md); }
  }

  .fora li { padding-left: var(--e-6); position: relative; color: var(--texto-suave); }
  .fora li::before { content: "—"; position: absolute; left: 0; color: var(--cinza-400); }
  .nota { font-size: var(--t-sm); color: var(--texto-suave); margin-top: var(--e-4); }

  .marcas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--e-6) var(--e-8);
    margin-top: var(--e-8);
    padding: var(--e-6) var(--e-8);
    background: #fff;
    border-radius: var(--r-3);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  .marcas img { display: block; height: 40px; width: auto; }
  .marcas li + li { position: relative; }
  @media (min-width: 700px) {
    .marcas li + li::before {
      content: "";
      position: absolute;
      left: calc(var(--e-8) / -2);
      top: 50%;
      transform: translateY(-50%);
      height: 40px;
      border-left: 1px solid rgba(0, 0, 0, 0.14);
    }
  }
  .marcas__nos { display: flex; align-items: center; gap: var(--e-3); }
  .marcas__nos img { height: 44px; }
  .marcas__nos span {
    display: grid;
    color: var(--marca-forte);
    font-weight: 700;
    font-size: var(--t-lg);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .marcas__nos small {
    color: var(--verde-700);
    font-size: var(--t-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>

<script>
  // Bandeira tarifária: quando a régua da ANEEL aparece na tela, a bandeira
  // passa sozinha, devagar, de verde a vermelha 2 (um degrau a cada PASSO_MS)
  // e para na vermelha 2, o estado que o texto descreve. Se a régua sai
  // inteira da tela, volta ao verde para tocar de novo na próxima vez.
  // Sem JS ou com movimento reduzido, fica parada na vermelha 2.
  const bandeira = document.querySelector<HTMLElement>(".secao--bandeira");
  const tarifa = bandeira?.querySelector<HTMLElement>(".tarifa__passos");
  if (bandeira && tarifa && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const PASSO_MS = 1800;
    let timers: number[] = [];
    const parar = () => { timers.forEach(clearTimeout); timers = []; };
    bandeira.dataset.bandeira = "0";
    new IntersectionObserver(([e]) => {
      if (e.intersectionRatio >= 0.6) {
        if (timers.length || bandeira.dataset.bandeira === "3") return;
        for (let p = 1; p <= 3; p++) {
          timers.push(window.setTimeout(() => { bandeira.dataset.bandeira = String(p); }, PASSO_MS * p));
        }
      } else if (e.intersectionRatio === 0) {
        parar();
        bandeira.dataset.bandeira = "0";
      }
    }, { threshold: [0, 0.6] }).observe(tarifa);
  }
  // Ímã dos cartões de imprensa. Um listener no window para todos os
  // alvos (não um por cartão) e só liga com ponteiro real + sem preferência
  // por movimento reduzido: os links já funcionam sem isto, a inclinação
  // é enriquecimento puro. Gira em torno de `rotate`, a mesma primitiva do
  // selo e do cordão — o cartão aponta para o cursor, não desliza até ele.
  const alvos = [...document.querySelectorAll<HTMLElement>("[data-ima]")].map((el) => ({
    el,
    alvo: 0,
    atual: 0,
    raf: 0,
  }));

  if (
    alvos.length &&
    matchMedia("(hover: hover)").matches &&
    matchMedia("(prefers-reduced-motion: no-preference)").matches
  ) {
    const RAIO = 130;
    const GIRO_MAX = 6;

    function passo(a: (typeof alvos)[number]) {
      a.atual += (a.alvo - a.atual) * 0.16;
      a.el.style.rotate = `${a.atual.toFixed(2)}deg`;
      const parado = Math.abs(a.alvo - a.atual) < 0.05;
      a.raf = parado ? 0 : requestAnimationFrame(() => passo(a));
    }

    addEventListener(
      "pointermove",
      (e) => {
        for (const a of alvos) {
          const r = a.el.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const d = Math.hypot(dx, dy);
          const f = d < RAIO ? 1 - d / RAIO : 0;
          a.alvo = Math.sign(dx) * f * GIRO_MAX;
          if (!a.raf) a.raf = requestAnimationFrame(() => passo(a));
        }
      },
      { passive: true },
    );
  }
</script>
