---
import Vertical from "../layouts/Vertical.astro";
import { COOPLUZ } from "../data/solucoes";
import Fatura from "../components/Fatura.astro";
import QuemPode from "../components/QuemPode.astro";

const solucao = COOPLUZ;

// Os três selos da seção de números. Posição de março/2026, relatório da
// Coopluz. O anel só repete dado que já está no título ou na nota.
const selos = [
  { numero: "3.865", rotulo: "cooperados", detalhe: "recebendo crédito hoje", anel: "Coopluz · Goiás · março de 2026 · Coopluz · Goiás · ", giro: "-6deg" },
  { numero: "10×", rotulo: "em quatro meses", detalhe: "dez/25 a mar/26", anel: "De dezembro a março · de 380 a 3.865 cooperados · ", giro: "4deg" },
  { numero: "1,66 mi", rotulo: "kWh compensados", detalhe: "no mês de março/2026", anel: "Energia solar compensada · 180 t de CO₂ evitadas · ", giro: "-3deg" },
];

const perguntas = [
  {
    p: "Preciso instalar placa solar no meu telhado?",
    r: "Não. A energia é gerada em fazendas solares cooperadas à Coopluz. Você recebe os créditos dessa geração abatidos na sua fatura — nada é instalado, nada é construído no seu imóvel.",
  },
  {
    p: "Vou trocar de distribuidora?",
    r: "Não. A Equatorial Goiás continua sendo sua distribuidora, a fatura continua vindo dela e a titularidade da conta permanece no seu nome. O que muda é o valor: os créditos de compensação entram como desconto.",
  },
  {
    p: "Quem pode participar?",
    r: "Residências, comércios e pequenas indústrias atendidos pela Equatorial Goiás com consumo médio acima de R$ 250 por mês. Abaixo desse valor o cadastro segue para análise da Coopluz, e a gente diz isso antes de você assinar.",
  },
  {
    p: "Em quanto tempo o desconto aparece na fatura?",
    r: "A aprovação do cadastro sai rápido. Já o primeiro crédito na fatura costuma aparecer em até 90 dias, porque depende do ciclo de leitura da distribuidora e do processo de vinculação da unidade consumidora à cooperativa.",
  },
  {
    p: "Meu nome está negativado. Posso participar?",
    r: "Pode. A adesão à Coopluz não passa por consulta ao SPC ou ao Serasa e não há análise de crédito: você não está contratando financiamento nem comprando equipamento, só recebendo créditos de energia na fatura que já é sua. O que impede a adesão é a conta estar em nome de outra pessoa, ter Tarifa Social ou isenção de ICMS de produtor rural, ou estar com irregularidade junto à distribuidora.",
  },
  {
    p: "Tem taxa de adesão, fidelidade ou multa para sair?",
    r: "Não há taxa de adesão nem multa de cancelamento. Ao sair, você paga apenas o saldo residual dos créditos já utilizados e não faturados.",
  },
  {
    p: "E se eu mudar de endereço?",
    r: "A participação pode ser transferida para o novo imóvel, desde que ele fique dentro da mesma área de concessão da distribuidora.",
  },
  {
    p: "Isso é legal?",
    r: "Sim. O sistema de compensação de energia elétrica é regulado pela ANEEL e amparado pela Lei 14.300/2022, que instituiu o marco legal da microgeração e minigeração distribuída no Brasil.",
  },
];
---

<Vertical
  solucao={solucao}
  h1="Pague 20% menos na conta da Equatorial Goiás, sem obra e sem placa no telhado"
  chamada="A Coopluz é uma cooperativa de energia por compensação. Você se torna cooperado, recebe créditos de fazendas solares cooperadas e o desconto entra direto na sua fatura. Sem instalar nada, sem trocar de distribuidora e sem taxa de adesão."
  perguntas={perguntas}
  tituloForm="Receba a análise da sua conta"
  rotuloBarra="Ver meu desconto"
>
  {/* A seção é a bandeira tarifária: o fundo passa por verde, amarela, vermelha 1
       e vermelha 2 enquanto ela atravessa a tela. Sem JS fica na vermelha 2 —
       o estado que o texto descreve. */}
  <section class="secao secao--bandeira" data-bandeira="3">
    <div class="container">
      <div class="bandeira__linha">
        <div class="bandeira" aria-hidden="true">
          <span class="bandeira__mastro"></span>
          <div class="bandeira__pano">
            <strong data-passo="0">Verde<small>sem cobrança extra</small></strong>
            <strong data-passo="1">Amarela<small>mais caro</small></strong>
            <strong data-passo="2">Vermelha 1<small>mais caro ainda</small></strong>
            <strong data-passo="3">Vermelha 2<small>a mais cara</small></strong>
          </div>
        </div>
        <div>
          <span class="olho">O problema</span>
          <h2>A conta de luz subiu e não tem como consumir menos</h2>
          <p class="chamada">
            Bandeira tarifária, reajuste anual e o calor de Goiás fizeram da luz uma das três maiores despesas fixas do
            mês. O que subiu foi o preço do kWh, não o seu uso — por isso apagar a luz não resolve.
          </p>
        </div>
      </div>
      {/* Régua da ANEEL: quanto cada bandeira soma por 100 kWh (R$/kWh da
           tabela oficial × 100, arredondado). Fonte: gov.br/aneel, página
           "Sobre Bandeiras Tarifárias", atualizada em 08/01/2026. */}
      <div class="tarifa">
        <div class="tarifa__titulo">
          <p id="tarifa-titulo">Quanto cada bandeira soma na sua conta, a cada 100 kWh</p>
          <small>
            Fonte:
            <a href="https://www.gov.br/aneel/pt-br/assuntos/tarifas/bandeiras-tarifarias" rel="noopener" target="_blank">ANEEL</a>,
            valores de 2026, antes dos impostos
          </small>
        </div>
        <ol class="tarifa__passos" role="list" aria-labelledby="tarifa-titulo">
          <li data-passo="0"><span>Verde</span><strong>R$ 0</strong><em>sem cobrança extra</em></li>
          <li data-passo="1"><span>Amarela</span><strong>+ R$ 1,89</strong><em>mais caro</em></li>
          <li data-passo="2"><span>Vermelha 1</span><strong>+ R$ 4,46</strong><em>mais caro ainda</em></li>
          <li data-passo="3"><span>Vermelha 2</span><strong>+ R$ 7,88</strong><em>a mais cara</em></li>
        </ol>
      </div>
      <div class="bandeira__saidas">
        <p class="bandeira__antes">
          <span>A saída conhecida</span>
          Placa solar no próprio telhado: obra, projeto e anos até o investimento voltar.
        </p>
        <p class="bandeira__agora">
          <span>Com a Coopluz</span>
          Você usa a energia de uma fazenda solar da cooperativa. Sem obra e sem investimento.
        </p>
      </div>
    </div>
  </section>

  <Fatura />

  <QuemPode />

  {/* Números, imprensa e leitura numa seção só (folha de 03/10, opção F).
       Os três números viram selos de carimbo: o anel de texto repete o que
       já está escrito na seção (título e nota), por isso é aria-hidden. */}
  <section class="secao secao--suave selos-secao" data-art="tres-selos" aria-labelledby="selos-titulo">
    <div class="container">
      <span class="olho">Números da cooperativa</span>
      <h2 id="selos-titulo">De 380 para 3.865 cooperados em quatro meses</h2>
      <ul class="selos" role="list">
        {selos.map((s, i) => (
          <li class="carimbo" style={`--giro: ${s.giro}`}>
            <svg class="carimbo__anel" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
              <defs><path id={`selo-anel-${i}`} d="M120,120 m-100,0 a100,100 0 1,1 200,0 a100,100 0 1,1 -200,0" /></defs>
              <text><textPath href={`#selo-anel-${i}`} textLength="618" lengthAdjust="spacing">{s.anel}</textPath></text>
            </svg>
            <div class="carimbo__miolo">
              <strong>{s.numero}</strong>
              <span>{s.rotulo}</span>
              <small>{s.detalhe}</small>
            </div>
          </li>
        ))}
      </ul>
      <p class="selos__nota">
        Posição de março/2026, conforme relatório da Coopluz — 180 t de CO₂ evitadas, equivalente a 720 árvores
        plantadas. A cooperativa segue crescendo mês a mês.
      </p>

      <div class="selos__linha">
        <h3>Visto na TV</h3>
        <ul class="lista-limpa selos__itens" role="list">
          <li>
            <a class="selos__video externo" href="https://www.youtube.com/watch?v=AajbB7OHUR0" target="_blank" rel="noopener">
              <span class="selos__play" aria-hidden="true"></span>
              <span>
                <small>Jovem Pan News</small>
                <b>Brasileiro já pode assinar luz em casa ou comércio</b>
              </span>
            </a>
          </li>
          <li>
            <a class="selos__video externo" href="https://www.youtube.com/watch?v=_pZob1Y9smI" target="_blank" rel="noopener">
              <span class="selos__play" aria-hidden="true"></span>
              <span>
                <small>Rede Globo</small>
                <b>Energia solar por assinatura: entenda como funciona</b>
              </span>
            </a>
          </li>
        </ul>
      </div>
      <div class="selos__linha">
        <h3>Antes de decidir, leia</h3>
        <ul class="lista-limpa selos__itens" role="list">
          <li><a class="selos__artigo" href="/blog/reduzir-conta-equatorial-sem-placa-solar">Como reduzir a conta da Equatorial Goiás sem instalar placa solar<span aria-hidden="true">→</span></a></li>
          <li><a class="selos__artigo" href="/blog/fio-b-60-por-cento-2026-conta-equatorial-goias">Fio B a 60% em 2026: por que a conta da Equatorial Goiás subiu<span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </div>
  </section>
  <section class="secao secao--suave">
    <div class="container">
      <span class="olho">Quem está por trás</span>
      <h2>Uma cooperativa de energia, uma de crédito e um representante autorizado</h2>
      <p class="chamada">
        A Coopluz é uma cooperativa independente com sede em Goiânia e opera em parceria com o Sicoob Secovicred.
        A Autogestor é representante autorizado: é com a gente que você fala e é a Coopluz que emite o
        termo de adesão. Nenhuma das três consulta SPC ou Serasa para o seu cadastro.
      </p>
      <p class="chamada">
        No material institucional da própria Coopluz, a Autogestor aparece listada como Representante Autorizado,
        ao lado do Sicoob Nova Central e do Sicoob Secovicred — não é só o que a gente diz sobre si.
      </p>
      <ul class="marcas lista-limpa" role="list">
        {/* O lockup OFICIAL da cooperativa vive só aqui: é atribuição de
             terceiro, não a marca do site. A marca do site é o símbolo do
             cabeçalho — misturar os dois é justamente o que FR-015 proíbe.
             Arquivo atualizado a partir do material de abril/2026; o que
             estava no repositório era a geração anterior da marca. */}
        <li><img src="/img/parceiros/coopluz.png" width="712" height="266" alt="Coopluz" loading="lazy" decoding="async" /></li>
        <li><img src="/img/parceiros/sicoob.png" width="254" height="86" alt="Sicoob Secovicred" loading="lazy" decoding="async" /></li>
        <li class="marcas__nos">
          <img src="/img/parceiros/autogestor.svg" width="44" height="44" alt="" loading="lazy" decoding="async" />
          <span>Autogestor<small>Representante autorizado</small></span>
        </li>
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <span class="olho">Do outro lado do balcão</span>
      <h2>Dá para ganhar com a Coopluz, e não só economizar</h2>
      <p class="chamada">
        Se você tem rede de contatos em Goiás, a Autogestor credencia parceiros para apresentar essa mesma economia:
        comissão na ativação de cada conta e renda recorrente sobre a carteira — o suficiente, com carteira formada,
        para zerar a própria conta de luz de quem indica. Sem investimento e com treinamento gratuito.{" "}
        <a href="/parceiro">Veja como funciona o programa de parceiros da energia</a>.
      </p>
    </div>
  </section>
</Vertical>

<style>
  /* art-direction · tres-selos · eixos: geometria/entrada/média · orçamento: ~0,3kb JS · 2026-10-03
     Números, imprensa e leitura numa seção só. Os números viram selos de
     carimbo nas três cores que a página já usa como objeto: o creme do papel
     (selo "Nome negativado?"), o verde da marca e o âmbar da lâmpada acesa.
     As cores dos selos são fixas nos dois temas do cordão, como o papel; o
     resto da seção segue os tokens globais.

     Contraste medido:
       selos — tinta #0b1f1c sobre creme #f6f3ea 15.4 · sobre verde #40ac68 5.96
               · sobre âmbar #f2c14e 10.2 (o anel é enfeite, aria-hidden)
       claro — veículo #6e5100 / #fff 7.39 · título #0b1f1c / #fff 17.1
       escuro — veículo #f2c14e / #113039 8.31 · título #e6f0f0 / #113039 12.0
     Sem camada de scroll: o fio do circuito já conduz a rolagem da página. */
  .selos-secao {
    --selo-creme: #f6f3ea;
    --selo-verde: #40ac68;
    --selo-ambar: #f2c14e;
    --selo-tinta: #0b1f1c;
    --selo-tracejado: rgba(11, 31, 28, 0.35);
    --selo-halo: 242, 193, 78;
    --selo-veiculo: light-dark(#6e5100, #f2c14e);
  }

  .selos {
    list-style: none;
    margin: var(--e-12) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--e-8);
    justify-items: center;
  }
  .carimbo {
    position: relative;
    width: 240px;
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    text-align: center;
    background: var(--selo-creme);
    color: var(--selo-tinta);
    rotate: var(--giro);
    box-shadow: 0 24px 60px -24px rgba(var(--selo-halo), 0.5);
    /* O miolo mede em cqi: o selo encolhe no celular e o número vai junto. */
    container-type: inline-size;
  }
  .carimbo:nth-child(2) { background: var(--selo-verde); }
  .carimbo:nth-child(3) { background: var(--selo-ambar); }
  .carimbo::before {
    content: "";
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    border: 2px dashed var(--selo-tracejado);
  }
  .carimbo__anel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: rotate var(--dur-cena) var(--ease-cena);
  }
  .carimbo__anel text {
    font-family: var(--fonte);
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    fill: currentColor;
  }
  .carimbo__miolo { position: relative; max-width: 64cqi; }
  .carimbo strong {
    display: block;
    font-family: var(--display);
    font-variation-settings: "wght" 800;
    font-size: 19cqi;
    line-height: 0.95;
    white-space: nowrap;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .carimbo span { display: block; margin-top: 1cqi; font-weight: 700; font-size: clamp(0.8125rem, 6.4cqi, 0.9375rem); line-height: 1.25; }
  .carimbo small { display: block; margin-top: 1cqi; font-size: clamp(0.6875rem, 5cqi, 0.75rem); line-height: 1.3; }

  /* Ponteiro: o anel gira um pouco sob o cursor, como carimbo na mão. */
  @media (hover: hover) {
    .carimbo:hover .carimbo__anel { rotate: 24deg; }
  }

  /* Entrada: quando a seção aparece, os selos são carimbados um a um. O
     script só põe o estado "espera" se houver movimento e observador; sem
     JS os selos já estão no lugar. */
  .selos-secao[data-carimbo="espera"] .carimbo { opacity: 0; scale: 1.3; rotate: calc(var(--giro) + 12deg); }
  .selos-secao[data-carimbo="feito"] .carimbo {
    transition:
      opacity var(--dur-base) var(--ease-saida),
      scale var(--dur-cena) var(--ease-cena),
      rotate var(--dur-cena) var(--ease-cena);
  }
  .selos-secao[data-carimbo="feito"] .carimbo:nth-child(2) { transition-delay: 140ms; }
  .selos-secao[data-carimbo="feito"] .carimbo:nth-child(3) { transition-delay: 280ms; }

  .selos__nota { max-width: 70ch; margin: var(--e-8) auto 0; text-align: center; font-size: var(--t-sm); color: var(--texto-suave); }

  .selos__linha {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--e-4) var(--e-6);
    align-items: center;
    margin-top: var(--e-4);
  }
  .selos__linha:first-of-type { margin-top: var(--e-12); padding-top: var(--e-8); border-top: 1px solid var(--borda); }
  .selos__linha h3 { margin: 0; font-size: var(--t-md); color: var(--texto-suave); }
  .selos__itens { grid-template-columns: 1fr 1fr; gap: var(--e-4); }
  .selos__itens li { display: flex; }
  .selos__video,
  .selos__artigo {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--e-4);
    min-height: 72px;
    padding: var(--e-3) var(--e-4);
    border-radius: var(--r-4);
    color: var(--texto);
    text-decoration: none;
    transition: border-color var(--dur-rapida) var(--curva), background-color var(--dur-rapida) var(--curva);
  }
  .selos__video { background: var(--superficie-alta); border: 1px solid var(--borda); }
  .selos__video:hover { color: var(--texto); border-color: var(--selo-veiculo); }
  .selos__video small {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--selo-veiculo);
  }
  .selos__video b { display: block; font-size: 0.9375rem; line-height: 1.3; }
  .selos__video::after { margin-left: auto; color: var(--texto-suave); }
  .selos__play {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--selo-ambar);
    display: grid;
    place-items: center;
    transition: scale var(--dur-rapida) var(--curva);
  }
  .selos__play::before {
    content: "";
    margin-left: 3px;
    border-left: 12px solid var(--selo-tinta);
    border-block: 8px solid transparent;
  }
  .selos__video:hover .selos__play { scale: 1.08; }
  .selos__artigo { justify-content: space-between; border: 1px solid var(--borda); font-weight: 600; font-size: 0.9375rem; line-height: 1.45; }
  .selos__artigo:hover { color: var(--texto); background: var(--superficie-alta); }
  .selos__artigo span { color: var(--verde-700); font-weight: 800; }

  @media (prefers-reduced-motion: reduce) {
    .carimbo__anel, .selos__play { transition: none; }
  }
  @media (max-width: 860px) {
    .selos { grid-template-columns: 1fr 1fr; gap: var(--e-4); }
    .carimbo { width: min(200px, calc((100vw - 5rem) / 2)); }
    .carimbo:nth-child(3) { grid-column: 1 / -1; }
    .selos__linha { grid-template-columns: 1fr; }
  }
  /* Abaixo de 560px dois selos lado a lado ficam com 150px e o miolo passa
     por cima do tracejado. Vira uma coluna em zigue-zague, encaixada. */
  @media (max-width: 559px) {
    .selos { grid-template-columns: 1fr; gap: 0; }
    .carimbo { width: 212px; justify-self: start; }
    .carimbo:nth-child(2) { justify-self: end; margin-top: -56px; }
    .carimbo:nth-child(3) { grid-column: auto; margin-top: -56px; }
    .selos__itens { grid-template-columns: 1fr; }
  }

  /* art-direction · bandeira-regua · eixos: pigmento/scroll/escura · orçamento: ~0,4kb JS · 2026-10-03
     "O problema" como a bandeira tarifária da conta. O fundo é sempre escuro
     (nos dois temas do cordão, como a capa): as quatro cores da ANEEL vão no
     pano e no topo de cada degrau da régua, e o fundo é a mesma cor quase
     apagada, para o texto creme passar em todas. Folha de 03/10, opção A:
     a régua com o valor oficial de cada bandeira substitui a borda de 4 cores,
     e a saída da Coopluz vira o único cartão claro da seção. */
  .secao--bandeira {
    --bandeira-fundo: #3a0d10;
    --bandeira-pano: #b3202a;
    --b-verde: #23804a;
    --b-amarela: #c99a1c;
    --b-vermelha1: #c94a24;
    --b-vermelha2: #b3202a;
    --b-creme: #f6f3ea;
    --b-creme-suave: #d4dddb;
    --b-apagado: #c9c2b8;
    --b-tinta: #0b1f1c;
    --b-ambar: #f2c14e;
    --b-ambar-tinta: #6e5100;
    --b-linha: rgba(246, 243, 234, 0.18);
    --b-degrau: rgba(246, 243, 234, 0.05);
    --b-brilho: rgba(242, 193, 78, 0.4);
    background: var(--bandeira-fundo);
    color: var(--b-creme);
    transition: background-color 900ms var(--ease-cena);
  }
  .secao--bandeira[data-bandeira="0"] { --bandeira-fundo: #0f3d26; --bandeira-pano: var(--b-verde); }
  .secao--bandeira[data-bandeira="1"] { --bandeira-fundo: #3d300a; --bandeira-pano: var(--b-amarela); }
  .secao--bandeira[data-bandeira="2"] { --bandeira-fundo: #3f1a0e; --bandeira-pano: var(--b-vermelha1); }
  .secao--bandeira::before { display: none; }
  .secao--bandeira .olho { color: var(--b-creme); opacity: 0.85; }
  .secao--bandeira h2 { color: var(--b-creme); font-size: clamp(2rem, 1.3rem + 2.4vw, 2.75rem); }
  .secao--bandeira .chamada { color: var(--b-creme-suave); }

  .bandeira__linha {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--e-12);
    align-items: center;
  }
  .bandeira__linha h2 { margin-bottom: 0; }
