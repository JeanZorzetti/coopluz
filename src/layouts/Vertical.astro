---
import Base from "./Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Faq from "../components/Faq.astro";
import type { Pergunta } from "../components/Faq.astro";
import BarraAcao from "../components/BarraAcao.astro";
import { AREA_SERVIDA, type Solucao } from "../data/solucoes";
import { ATENDIMENTO, EMPRESA } from "../consts";

interface Props {
  solucao: Solucao;
  h1: string;
  chamada: string;
  perguntas: readonly Pergunta[];
  /** Tipo de nó schema.org que melhor descreve a vertical. */
  tipoServico?: string;
  tituloForm?: string;
  rotuloBarra?: string;
}
const {
  solucao,
  h1,
  chamada,
  perguntas,
  tipoServico = "Service",
  tituloForm = "Peça sua cotação",
  rotuloBarra = "Pedir cotação",
} = Astro.props;
const site = Astro.site ?? new URL("https://coopluz.roilabs.com.br");
// Solução única do site: URL é a própria home, não "/coopluz".
const url = new URL("/", site).href;

const schema = [
  {
    "@type": tipoServico,
    "@id": `${url}#servico`,
    name: solucao.nome,
    description: solucao.descricao,
    url,
    // Coopluz é quem presta o serviço; a Autogestor é representante autorizado
    // (broker), não a prestadora. Os dois entram por `@id` nos nós que o
    // Base.astro já declara: `{ name: "Coopluz" }` criava um SEGUNDO nó anônimo
    // com o nome da cooperativa no mesmo grafo que já tem `#cooperativa` — duas
    // entidades para a mesma organização, que é exatamente a duplicação que o
    // grafo único existe para evitar.
    provider: solucao.provedor
      ? { "@id": new URL("/#cooperativa", site).href }
      : { "@id": new URL("/#operadora", site).href },
    ...(solucao.provedor && { broker: { "@id": new URL("/#operadora", site).href } }),
    areaServed: AREA_SERVIDA[solucao.abrangencia],
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: perguntas.map((q) => ({
      "@type": "Question",
      name: q.p,
      acceptedAnswer: { "@type": "Answer", text: q.r.replace(/<[^>]+>/g, "") },
    })),
  },
];
---

<Base titulo={solucao.titulo} descricao={solucao.descricao} schema={schema}>
  <section class="topo">
    {/* A marca vira textura da capa: o mesmo símbolo do cabeçalho, grande,
         recortando um gradiente da própria página. `aria-hidden` porque não
         acrescenta informação — quem lê por leitor de tela já ouviu a marca no
         cabeçalho. Tudo atrás de @supports em global.css: sem máscara ou sem
         timeline de scroll, ele simplesmente não existe e a capa continua
         composta. */}
    <span class="selo selo--claro selo--entra" aria-hidden="true"></span>
    <div class="container topo__grade">
      <div class="topo__texto">
        <span class="olho">{solucao.nome}</span>
        <h1>{h1}</h1>
        <p class="chamada">{chamada}</p>
        <slot name="hero" />
      </div>
      <div class="topo__form">
        <LeadForm solucao={solucao} titulo={tituloForm} instancia="topo" />
      </div>
    </div>
  </section>

  <slot />

  <section class="secao secao--suave">
    <div class="container">
      <Faq perguntas={perguntas} />
    </div>
  </section>

  <section class="secao" id="pedir" tabindex="-1">
    <div class="container fechamento">
      <div>
        <span class="olho">Próximo passo</span>
        <h2>{solucao.fechamento}</h2>
        <p class="chamada">
          {/* Sem SUSEP aqui: a Autogestor é representante autorizado da
               Coopluz nesta vertical, não corretora de seguros (Clarifications
               da spec 002-coopluz-standalone-site). */}
          Um consultor da Autogestor responde no seu WhatsApp {ATENDIMENTO.prazo}. Representante autorizado da
          Coopluz desde {EMPRESA.fundacao}, com sede em {EMPRESA.endereco.cidade}, atendendo a área de concessão
          da Equatorial Goiás.
        </p>
      </div>
      <LeadForm solucao={solucao} titulo={tituloForm} destaque instancia="fim" />
    </div>
  </section>

  {/* Sem a seção "Outras soluções do hub": este site tem 1 vertical só. */}

  <BarraAcao solucao={solucao} rotulo={rotuloBarra} />
</Base>

<style>
  /* `overflow: clip` e não `hidden`: clip não cria contexto de rolagem, então
     a âncora `#pedir` mais abaixo continua funcionando e nenhuma barra de
     rolagem fantasma aparece quando o selo sangra para fora. */
  .topo {
    position: relative;
    overflow: clip;
  }
  /* Tamanho e posição são de quem chama; a matéria (máscara, gradiente,
     opacidade) mora no .selo do global.css. O giro negativo tira a lâmpada da
     vertical perfeita — simétrico demais lê como ícone, não como textura. */
  .topo .selo {
    width: min(48vw, 520px);
    left: -11%;
    bottom: -44%;
    --giro: -8deg;
  }
  @media (max-width: 899px) {
    /* No celular a coluna de texto ocupa a largura inteira e o formulário
       desce: o selo sai do canto e vira uma faixa atrás do fim do texto. */
    .topo .selo { width: 86vw; left: -30%; bottom: -30%; }
  }
</style>
