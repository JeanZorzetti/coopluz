---
import { ICONES } from "../data/solucoes";
import { EMPRESA, SITE, whatsapp } from "../consts";
import Logo from "./Logo.astro";

const { pathname } = Astro.url;
const atual = (href: string) => pathname === href || pathname === `${href}/`;

// Site de 1 vertical: 3 links fixos em vez do `.map()` sobre `SOLUCOES` do
// hub (que tem 6). Mesma decisão de "sem hambúrguer" do hub — a lista cabe.
const NAV = [
  { href: "/", rotulo: "Início" },
  { href: "/parceiro", rotulo: "Seja parceiro" },
  { href: "/blog", rotulo: "Blog" },
];
---

<header class="cabecalho">
  <div class="container cabecalho__linha">
    {/* Lockup em duas linhas, e não a marca sozinha: FR-012 exige que quem
         opera o site seja legível SEM rolagem, em qualquer largura. O selo
         não é letra miúda de rodapé — sobe para o topo, ao lado do nome, e é
         a primeira coisa que a pessoa lê depois da marca.
         O `aria-label` carrega as duas informações porque o leitor de tela
         anuncia o link inteiro de uma vez; o `aria-hidden` no texto evita que
         ele leia tudo duas vezes. */}
    <a
      href="/"
      class="marca"
      aria-label={`${SITE.nome}, ${SITE.papel.toLowerCase()} ${EMPRESA.nome} — página inicial`}
    >
      <Logo size={44} />
      <span class="marca__texto" aria-hidden="true">
        <span class="marca__nome">{SITE.nome}</span>
        <span class="marca__papel">{SITE.papel} <b>{EMPRESA.nome}</b></span>
      </span>
    </a>
    <a class="cabecalho__zap externo" href={whatsapp("Olá! Vim pelo site da Coopluz.")} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONES.zap} />
      WhatsApp
      <span class="visualmente-oculto">— abre em nova aba</span>
    </a>

    {/* O interruptor da página. Nasce `hidden`: sem JS não faria nada, e botão
         morto é pior que botão ausente — o script revela, e só se light-dark()
         existir (sem ela o tema escuro nem chega a ser aplicado).
         É um <button> de verdade: o arrasto é enriquecimento, o clique e o
         Enter/Espaço são o caminho garantido. O estado vai em aria-pressed, e
         o rótulo muda junto com ele — o brilho do bulbo nunca é o único sinal. */}
    <button class="cordao" type="button" aria-pressed="false" hidden>
      <span class="cordao__fio" aria-hidden="true"></span>
      <span class="cordao__bulbo" aria-hidden="true"></span>
      <span class="visualmente-oculto cordao__rotulo">Apagar a página (tema escuro)</span>
    </button>
    <nav class="nav" aria-label="Navegação">
      <ul class="nav__lista" role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={atual(item.href) ? "page" : undefined}>
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecalho {
    background: var(--superficie-alta);
    border-bottom: 1px solid var(--borda);
    z-index: 20;
  }
  @media (min-width: 900px) {
    .cabecalho { position: sticky; top: 0; }
  }
  .cabecalho__linha {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding-block: var(--e-3);
  }
  /* Preso ao topo da primeira linha, sempre — `height` fixa e não `bottom: 0`
     porque no celular esta caixa contém TAMBÉM a linha da navegação, e o
     cordão só pende da primeira. 56px = padding-block (12) + alvo (44). */
  .cordao {
    position: absolute;
    right: 0;
    top: 0;
    height: 56px;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: var(--e-3);
    text-decoration: none;
    color: var(--marca-forte);
  }
  .marca__texto { display: grid; gap: 1px; }
  .marca__nome {
    font-family: var(--display);
    font-variation-settings: "wght" 700;
    font-size: var(--t-lg);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  /* 0.6875rem (11px) e não --t-sm: a 360px o lockup inteiro precisa caber ao
     lado do símbolo sem quebrar a linha do WhatsApp para baixo. Abaixo disso
     o texto deixa de ser lido, e um selo que ninguém lê não cumpre FR-012. */
  .marca__papel {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--texto-suave);
    text-transform: uppercase;
  }
  .marca__papel b { font-weight: 700; color: var(--texto); }
  .cabecalho__zap {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding-inline: var(--e-4);
    border-radius: var(--r-full);
    background: var(--azul-100);
    color: var(--marca-forte);
    font-weight: 700;
    font-size: var(--t-sm);
    text-decoration: none;
  }
  .cabecalho__zap:hover { background: var(--cinza-100); }
  /* Reserva o corredor do cordão. Ele é absoluto e não empurra ninguém, então
     sem esta margem ele cairia em cima da pílula do WhatsApp a 360px. */
  .cabecalho__zap { margin-right: 42px; }

  /* 3 itens cabem numa linha mesmo no celular — sem o scroll horizontal que o
     hub precisa para 6 verticais. */
  .nav {
    flex-basis: 100%;
    border-top: 1px solid var(--borda);
    background: var(--superficie);
    margin-inline: calc(-1 * var(--e-4));
    width: calc(100% + var(--e-8));
  }
  @media (min-width: 900px) {
    .nav {
      order: 2;
      flex-basis: auto;
      width: auto;
      margin-inline: 0;
      border-top: none;
      background: none;
    }
    .cabecalho__zap { order: 3; }
  }
  .nav__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-2);
    list-style: none;
    margin-block: 0;
    padding-inline: var(--e-4);
    padding-block: var(--e-2);
  }
  @media (min-width: 900px) {
    .nav__lista { padding: 0; }
  }
  .nav__lista a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--e-2) var(--e-3);
    border-radius: var(--r-2);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .nav__lista a:hover { background: var(--cinza-100); color: var(--texto); }
  .nav__lista a[aria-current="page"] {
    color: var(--marca-forte);
    background: var(--fundo);
    box-shadow: inset 0 -3px 0 var(--acento);
  }
</style>

<script>
  const cordao = document.querySelector<HTMLButtonElement>(".cordao");

  // Mesma guarda do seletor que ele substitui: sem light-dark() o tema escuro
  // está atrás de @supports e nem é aplicado, então o botão prometeria e não
  // entregaria.
  if (cordao && CSS.supports("color", "light-dark(#fff, #000)")) {
    const raiz = document.documentElement;
    const rotulo = cordao.querySelector<HTMLElement>(".cordao__rotulo")!;
    const escuroDoSistema = matchMedia("(prefers-color-scheme: dark)");
    const estaEscuro = () => (raiz.dataset.tema ? raiz.dataset.tema === "escuro" : escuroDoSistema.matches);

    const sincronizar = () => {
      const escuro = estaEscuro();
      // Aceso = página clara. Três sinais para o mesmo estado: o brilho (visual),
      // o aria-pressed (programático) e o rótulo (texto).
      cordao.toggleAttribute("data-aceso", !escuro);
      cordao.setAttribute("aria-pressed", String(escuro));
      rotulo.textContent = escuro ? "Acender a página (tema claro)" : "Apagar a página (tema escuro)";
      const cor = escuro ? "#051419" : "#0b3d47";
      document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute("content", cor));
    };

    // O balanço do pêndulo. Reiniciado ANTES de mexer no tema, e a ordem não é
    // estética: aqui o layout ainda está limpo e a leitura de offsetWidth sai
    // do cache; depois de escrever dataset.tema ela forçaria um reflow síncrono
    // da página inteira no frame do clique — exatamente o que o resto deste
    // arquivo existe para evitar. Sem a releitura, puxar duas vezes seguidas
    // não reiniciaria a animação: o atributo já estaria lá.
    const balancar = () => {
      cordao.removeAttribute("data-quicando");
      void cordao.offsetWidth;
      cordao.setAttribute("data-quicando", "");
    };
    cordao.addEventListener("animationend", () => cordao.removeAttribute("data-quicando"));

    const alternar = () => {
      balancar();
      // Trava as transições durante a troca: sem isso, todo botão e chip da
      // página interpola cor no mesmo frame do clique. Ver o comentário em
      // global.css — vale INP e vale nitidez.
      raiz.dataset.trocandoTema = "";
      raiz.dataset.tema = estaEscuro() ? "claro" : "escuro";
      try {
        localStorage.setItem("tema", raiz.dataset.tema);
      } catch {}
      sincronizar();
      requestAnimationFrame(() =>
        requestAnimationFrame(() => delete raiz.dataset.trocandoTema)
      );
    };

    cordao.hidden = false;
    sincronizar();

    let suprimirClique = false;
    cordao.addEventListener("click", () => {
      // Um arrasto que passou do limiar já alternou, e o navegador dispara um
      // clique logo depois — sem esta trava ele alternaria de volta e o gesto
      // não faria nada. Bandeira em vez de stopImmediatePropagation porque a
      // ordem entre listeners do mesmo elemento depende da ordem de registro,
      // e depender disso é o tipo de sutileza que quebra em silêncio.
      if (suprimirClique) {
        suprimirClique = false;
        return;
      }
      alternar();
    });

    escuroDoSistema.addEventListener("change", () => {
      if (!raiz.dataset.tema) sincronizar();
    });

    // --- camada de ponteiro: puxar o cordão -------------------------------
    // Enriquecimento puro. Nada aqui é alcançável só por arrasto.
    const LIMIAR = 18;
    const MAX = 34;
    let inicioY: number | null = null;
    let arrastou = false;

    cordao.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" && e.button !== 0) return;
      inicioY = e.clientY;
      arrastou = false;
      cordao.setPointerCapture(e.pointerId);
    });

    cordao.addEventListener("pointermove", (e) => {
      if (inicioY === null) return;
      const dy = Math.max(0, Math.min(MAX, e.clientY - inicioY));
      if (dy > 4) {
        arrastou = true;
        cordao.setAttribute("data-arrastando", "");
      }
      // Escreve numa custom property e deixa o CSS desenhar: o fio estica e o
      // bulbo desce lendo o mesmo --puxao, sem o JS tocar em geometria.
      cordao.style.setProperty("--puxao", dy + "px");
    });

    const soltar = (e: PointerEvent) => {
      if (inicioY === null) return;
      const dy = Math.max(0, e.clientY - inicioY);
      inicioY = null;
      cordao.removeAttribute("data-arrastando");
      // Devolve o controle da geometria ao CSS, que agora tem a mola ligada.
      cordao.style.removeProperty("--puxao");
      if (arrastou) suprimirClique = true;
      if (dy >= LIMIAR) alternar();
    };

    cordao.addEventListener("pointerup", soltar);
    cordao.addEventListener("pointercancel", soltar);
  }
</script>
