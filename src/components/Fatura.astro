---
/**
 * COMO FUNCIONA — direção "antes e depois" (pigmento · estado · clara).
 *
 * Substitui a folha presa com quatro passos rolando ao lado (direção "fatura",
 * 22/08). Ela pedia quase três telas de rolagem para quatro passos curtos: quem
 * chegava via uma folha pequena, um gráfico em branco e um vão escuro à
 * direita, e o primeiro passo só aparecia depois de meia tela. Escolhida pela
 * dona numa folha de três (A Impressão na hora · B Antes e depois · C Noventa
 * dias), em 03/10/2026.
 *
 * A seção inteira cabe numa tela e conta UMA coisa: a mesma conta, duas vezes.
 * À esquerda a de hoje (R$ 700), por cima dela a que chega com a Coopluz
 * (R$ 560), e a diferença em reais grande ao lado. Os quatro passos viram a
 * linha do tempo embaixo, de "hoje" a "até 90 dias".
 *
 * O verbo é CHEGAR: quando a mesa aparece, a linha do tempo corre sozinha e a
 * conta nova cai em cima da velha — o mesmo "toca sozinho ao aparecer" que a
 * dona pediu para a régua da ANEEL na seção de cima. A lâmpada da marca é o
 * interruptor que troca as duas contas: apagada, você vê a conta de hoje;
 * acesa, a da Coopluz.
 *
 * NÃO É FAC-SÍMILE. Nada de marca, cor ou diagramação da Equatorial: as
 * rubricas são a estrutura tarifária pública da ANEEL, comum a qualquer
 * distribuidora, e os valores estão rotulados como exemplo no papel, na
 * legenda da tabela e no rodapé.
 *
 * Sem JS a mesa sai já no estado final (a conta da Coopluz por cima, linha do
 * tempo cheia) e o interruptor nem aparece: ele só existe para quem pode usar.
 */

/* As rubricas somam exatamente 700,00, e 20% de 700 é 140 — o mesmo par que a
   página usa na régua da capa. Exemplo que não fecha na soma é a primeira
   coisa que um leitor atento confere. */
const rubricas = [
  { nome: "Energia elétrica (TE)", valor: "289,40" },
  { nome: "Uso do sistema (TUSD)", valor: "301,15" },
  { nome: "Bandeira tarifária", valor: "18,90" },
  { nome: "Iluminação pública", valor: "12,55" },
  { nome: "Tributos (ICMS, PIS, COFINS)", valor: "78,00" },
];

/* Créditos em kWh. Os três primeiros meses são zero de propósito: é a unidade
   ANTES da adesão. Altura em % do maior. */
const historico = [
  { mes: "abr", kwh: 0 }, { mes: "mai", kwh: 0 }, { mes: "jun", kwh: 0 },
  { mes: "jul", kwh: 148 }, { mes: "ago", kwh: 312 }, { mes: "set", kwh: 486 },
  { mes: "out", kwh: 502 }, { mes: "nov", kwh: 478 }, { mes: "dez", kwh: 511 },
  { mes: "jan", kwh: 530 }, { mes: "fev", kwh: 498 }, { mes: "mar", kwh: 540 },
];
const teto = Math.max(...historico.map((m) => m.kwh));

const passos = [
  {
    quando: "Hoje",
    titulo: "Você faz a adesão",
    texto: "Cadastro digital com uma fatura recente em mãos. Sem visita técnica e sem consulta ao SPC ou Serasa.",
  },
  {
    quando: "Todo mês",
    titulo: "A fazenda gera",
    texto: "Usinas solares cooperadas injetam energia na rede da distribuidora. Cada mês vira um crédito em kWh.",
  },
  {
    quando: "Na fatura",
    titulo: "Os créditos entram no seu medidor",
    texto: "Eles aparecem como uma rubrica nova, negativa: energia compensada.",
  },
  {
    quando: "Até 90 dias",
    titulo: "A fatura chega menor",
    texto: "A mesma conta de sempre, com 20% de desconto. Nada foi instalado e nada foi trocado.",
  },
];
---

<section class="fatura" data-conta="coopluz" aria-labelledby="fatura-titulo">
  <div class="container">
    <div class="fatura__cab">
      <div>
        <span class="olho">Como funciona</span>
        <h2 id="fatura-titulo">Quatro passos até a sua conta chegar menor</h2>
        <p class="chamada">
          Acompanhe pela própria fatura: a cada passo, um pedaço do documento muda.
        </p>
      </div>

      {/* O interruptor. Dois botões com aria-pressed, e não um checkbox: as
           duas posições têm nome próprio, e quem ouve a página precisa saber
           qual conta está na frente sem adivinhar o que "ligado" quer dizer. */}
      <div class="chave" role="group" aria-label="Qual conta ver">
        <button type="button" data-ver="hoje" aria-pressed="false">Conta de hoje</button>
        <button type="button" data-ver="coopluz" aria-pressed="true">
          <svg class="chave__lampada" viewBox="13 4.9 74 93.7" aria-hidden="true" focusable="false">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path stroke-width="9.5" d="M75.16 25.16A30 30 0 0 1 72.47 61.38A30 30 0 0 1 36.85 68.46A30 30 0 0 1 20.5 36.03A30 30 0 0 1 47.39 11.61" />
              <path stroke-width="6" d="M41 78.5H59M44.25 85.5H55.75M46 92Q50 95.1 54 92" />
            </g>
            <path fill="currentColor" fill-rule="evenodd" d="M37.04 53.46A18.75 18.75 0 0 1 58.96 31.54A18.75 18.75 0 0 1 37.04 53.46ZM40.22 50.28Q49.03 44.59 54.72 35.78Q46.9 42.46 40.22 50.28Z" />
          </svg>
          Com a Coopluz
        </button>
      </div>
    </div>

    <div class="fatura__mesa">
      {/* A CONTA DE HOJE. Sem histórico (não há crédito antes da adesão) e sem
           carimbo. Fica atrás, desbotada e torta: é a conta que sai de cena. */}
      <div class="conta conta--hoje">
        <span class="conta__etiqueta">Hoje</span>
        <div class="papel">
          <p class="papel__ref">Fatura de energia<span>exemplo · ref. 12/2025</span></p>
          <table class="papel__conta">
            <caption class="visualmente-oculto">
              Exemplo da mesma fatura hoje, antes da adesão: total de R$ 700,00.
            </caption>
            <tbody>
              {rubricas.map((r) => (
                <tr class="papel__rubrica"><th scope="row">{r.nome}</th><td>{r.valor}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="papel__total"><span>Total a pagar</span><strong>R$ 700</strong></p>
        </div>
      </div>

      {/* A CONTA COM A COOPLUZ. A única com sombra verde: é o objeto aceso da
           mesa. Cada parte dela responde a um passo da linha do tempo. */}
      <div class="conta conta--coopluz">
        <span class="conta__etiqueta">Até 90 dias depois</span>
        <div class="papel">
          <div class="papel__topo">
            <p class="papel__ref">Fatura de energia<span>exemplo · ref. 03/2026</span></p>
            <p class="papel__carimbo">Unidade<br />vinculada</p>
          </div>
          <div class="papel__historico">
            <p class="papel__rotulo">Créditos da usina cooperada (kWh)</p>
            <ul class="papel__barras" role="list">
              {historico.map((m) => (
                <li>
                  <span style={`--h:${Math.round((m.kwh / teto) * 100)}%`}>
                    <span class="visualmente-oculto">{m.mes}: {m.kwh} kWh</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <table class="papel__conta">
            <caption class="visualmente-oculto">
              Exemplo da mesma fatura até 90 dias depois da adesão: R$ 700,00 menos
              R$ 140,00 de energia compensada, total de R$ 560,00. Ilustração da
              estrutura tarifária da ANEEL; não reproduz o documento de nenhuma
              distribuidora e os valores não são de uma conta real.
            </caption>
            <tbody>
              {rubricas.map((r) => (
                <tr class="papel__rubrica"><th scope="row">{r.nome}</th><td>{r.valor}</td></tr>
              ))}
              <tr class="papel__credito">
                <th scope="row">Energia compensada (GD)</th>
                <td>&minus;140,00</td>
              </tr>
            </tbody>
          </table>
          <p class="papel__total"><span>Total a pagar</span><strong>R$ 560</strong></p>
          <p class="papel__miudo">Ilustração da estrutura tarifária da ANEEL &middot; valores de exemplo</p>
        </div>
      </div>

      <div class="fatura__diferenca">
        <p class="fatura__menos"><b>&minus;R$ 140</b><span>todo mês, na mesma conta</span></p>
        {/* A classe fica: a barra de ação fixa (BarraAcao.astro) some enquanto
             esta linha está na tela, para não cobrir a última frase do bloco. */}
        <p class="fatura__outras">
          Sua conta é outra? <b>R$ 450</b> viram R$ 90 de desconto &middot; <b>R$ 1.200</b>
          viram R$ 240. Sempre 20%, todo mês.
        </p>
      </div>
    </div>

    <ol class="fatura__linha" role="list">
      {passos.map((p) => (
        <li>
          <small>{p.quando}</small>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* art-direction · antes-e-depois · eixos: pigmento/estado/clara · orçamento: 1kb JS · 2026-10-03 */

  /* -----------------------------------------------------------------------
     TOKENS DA MESA — com escopo nesta seção, não no global.
     A mesa é a única faixa clara entre a capa e "O problema" (escuras) e o
     resto da página: papel de escritório sob luz de dia. No tema escuro ela
     vira madeira quase preta e as contas continuam creme — conta de luz não
     fica preta quando o visitante puxa o cordão.
     Medidos (WCAG, texto sobre a mesa): tinta 10.83 · tinta-2 5.55 ·
     verde 5.28 (o --papel-credito #1d7a45 dava 4.26 aqui e reprovava) ·
     tinta-2 sobre o trilho da chave 4.77. No escuro: 15.07 · 8.95 · 8.20.
     ----------------------------------------------------------------------- */
  .fatura {
    --mesa: #ebe5d4;
    --mesa-tinta: #2a2f2c;
    --mesa-tinta-2: #545b56;
    --mesa-verde: #186a3b;
    --mesa-trilho: #ddd5c0;
    --mesa-apagado: #c9c0a8;
    --mesa-foco: #17579a;
    --mesa-sombra: #54401a;
    --conta-sombra-verde: #1d7a45;
    --papel-realce: #e3f2df;
  }
  @supports (color: light-dark(#fff, #000)) {
    .fatura {
      --mesa: light-dark(#ebe5d4, #17150f);
      --mesa-tinta: light-dark(#2a2f2c, #efe9da);
      --mesa-tinta-2: light-dark(#545b56, #bdb5a2);
      --mesa-verde: light-dark(#186a3b, #63c08a);
      --mesa-trilho: light-dark(#ddd5c0, #2a2720);
      --mesa-apagado: light-dark(#c9c0a8, #3d382e);
      --mesa-foco: light-dark(#17579a, #7cc4f2);
      --mesa-sombra: light-dark(#54401a, #0a0703);
      --conta-sombra-verde: light-dark(#1d7a45, #03170c);
    }
  }

  .fatura {
    position: relative;
    padding-block: var(--e-16);
    background: var(--mesa);
    color: var(--mesa-tinta);
  }
  /* Fibra da mesa. Um grão só, baixo: quem tem fibra de verdade são as contas. */
  .fatura::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--grao);
    background-size: 240px 240px;
    opacity: 0.06;
    mix-blend-mode: multiply;
  }
  .fatura > .container { position: relative; }
  .fatura .olho { color: var(--mesa-verde); }
  .fatura h2 { color: var(--mesa-tinta); }
  .fatura .chamada { color: var(--mesa-tinta-2); }
  /* O global pinta o anel de branco em .fatura (era a mesa teal). Na mesa
     clara branco some; volta para o azul de foco, 5.82:1. */
  .fatura :focus-visible { outline-color: var(--mesa-foco); }

  .fatura__cab {
    display: grid;
    gap: var(--e-6);
    align-items: end;
  }
  @media (min-width: 900px) {
    .fatura__cab { grid-template-columns: minmax(0, 1fr) auto; gap: var(--e-8); }
  }

  /* --- o interruptor ------------------------------------------------------ */
  .chave {
    justify-self: start;
    display: inline-flex;
    padding: 5px;
    border-radius: 999px;
    background: var(--mesa-trilho);
    box-shadow: inset 0 1px 2px color-mix(in srgb, var(--mesa-sombra) 22%, transparent);
  }
  /* Sem JS o botão não faz nada; melhor não existir do que mentir. Por CSS e
     não por script, para não empurrar a página depois da pintura. */
  @media (scripting: none) { .chave { display: none; } }
  .chave button {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding: 0 var(--e-4);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--mesa-tinta-2);
    font: inherit;
    font-weight: 700;
    font-size: var(--t-sm);
    cursor: pointer;
    transition: background-color var(--dur-rapida) var(--curva), color var(--dur-rapida) var(--curva);
  }
  .chave button[aria-pressed="true"] {
    background: var(--teal-900);
    color: var(--papel);
    box-shadow: 0 6px 14px color-mix(in srgb, var(--teal-900) 35%, transparent);
  }
  .chave__lampada { width: 18px; height: 22px; flex: none; color: var(--mesa-tinta-2); }
  [aria-pressed="true"] > .chave__lampada {
    color: var(--brasa);
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--brasa) 70%, transparent));
  }

  /* --- a mesa ------------------------------------------------------------- */
  .fatura__mesa {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--e-2);
    align-items: start;
    margin-top: var(--e-12);
  }
  /* 760 e não 900: num tablet de 820 o arranjo do celular esticava cada conta
     para 400px com três linhas dentro — duas caixas vazias. A partir daqui as
     contas inteiras cabem, e a diferença vai para a terceira coluna. */
  @media (min-width: 760px) {
    .fatura__mesa {
      grid-template-columns: minmax(0, 330px) minmax(0, 330px) minmax(180px, 1fr);
      column-gap: var(--e-4);
      margin-top: var(--e-12);
    }
  }

  .conta { position: relative; }
  .conta__etiqueta {
    display: block;
    margin-bottom: var(--e-2);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mesa-tinta-2);
  }
  .conta--coopluz .conta__etiqueta { color: var(--mesa-verde); }

  /* A de hoje mais baixa, torta para a esquerda; a da Coopluz mais alta, torta
     para o outro lado. O giro desencontrado é o que faz duas folhas lerem como
     objetos jogados na mesa, e não como dois cartões lado a lado. SEM
     sobreposição: o total fica alinhado à direita, e a conta da frente
     cobria justamente o "R$ 700" da de trás — o número que a mesa existe para
     mostrar. */
  .conta--hoje { margin-top: var(--e-8); rotate: -4deg; }
  .conta--coopluz { z-index: 1; rotate: 2deg; }
  @media (min-width: 760px) {
    .conta--hoje { margin-top: var(--e-12); }
  }

  /* --- o papel: mesma matéria da direção anterior ------------------------- */
  .papel {
    position: relative;
    padding: var(--e-3);
    border-radius: 2px;
    background: var(--papel);
    color: var(--papel-tinta);
    font-size: 0.66rem;
    line-height: 1.45;
    /* Luz de cima (--luz-azimute: 90deg): a sombra cai só em Y. Rampa de
       quatro degraus na cor da mesa, nunca preta. */
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--mesa-sombra) 14%, transparent),
      0 4px 8px color-mix(in srgb, var(--mesa-sombra) 12%, transparent),
      0 12px 24px color-mix(in srgb, var(--mesa-sombra) 12%, transparent),
      0 32px 56px color-mix(in srgb, var(--mesa-sombra) 10%, transparent);
  }
  @media (min-width: 760px) { .papel { padding: var(--e-4) 1.25rem; font-size: 0.84rem; } }
  .papel::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background-image: var(--grao), var(--grao);
    background-size: 240px 240px, 90px 90px;
    opacity: 0.055;
    mix-blend-mode: multiply;
  }
  /* A de hoje perde a cor: saturação baixa, parada (filtro que não anima). */
  .conta--hoje .papel { filter: saturate(0.35); }
  .conta--coopluz .papel {
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--conta-sombra-verde) 16%, transparent),
      0 6px 12px color-mix(in srgb, var(--conta-sombra-verde) 16%, transparent),
      0 18px 32px color-mix(in srgb, var(--conta-sombra-verde) 18%, transparent),
      0 40px 64px color-mix(in srgb, var(--conta-sombra-verde) 14%, transparent);
  }

  .papel__topo { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--e-2); }
  .papel__ref { margin: 0; font-weight: 700; }
  .papel__ref span { display: block; font-weight: 400; font-size: 0.86em; color: var(--papel-tinta-2); }
  .papel__carimbo {
    flex: none;
    margin: 0;
    padding: 3px 6px;
    border: 2px solid var(--papel-credito);
    border-radius: 3px;
    color: var(--papel-credito);
    font-size: 0.72em;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    rotate: -5deg;
  }
  .papel__historico { margin-top: var(--e-2); padding-block: var(--e-2); border-block: 1px solid var(--papel-linha); }
  .papel__rotulo { margin: 0 0 var(--e-1); font-size: 0.82em; color: var(--papel-tinta-2); }
  .papel__barras { display: flex; align-items: flex-end; gap: 3px; height: 26px; margin: 0; padding: 0; list-style: none; }
  .papel__barras li { flex: 1; display: flex; align-items: flex-end; height: 100%; }
  .papel__barras li > span { width: 100%; height: var(--h); min-height: 2px; background: var(--papel-barra); }
  .papel__barras li:last-child > span { background: var(--papel-credito); }

  .papel__conta { width: 100%; margin-top: var(--e-2); border-collapse: collapse; }
  .papel__conta th, .papel__conta td { padding: 2px 0; text-align: left; font-weight: 400; }
  .papel__conta td { text-align: right; font-variant-numeric: tabular-nums; }
  .papel__credito th, .papel__credito td {
    padding-top: var(--e-2);
    border-top: 1px solid var(--papel-linha);
    color: var(--papel-credito);
    font-weight: 700;
  }
  .papel__total {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--e-2);
    margin: var(--e-2) 0 0;
    padding-top: var(--e-2);
    border-top: 2px solid var(--papel-tinta);
  }
  .papel__total span { font-size: 0.86em; color: var(--papel-tinta-2); }
  .papel__total strong {
    font-family: var(--display);
    font-variation-settings: "wght" 900;
    font-weight: 900;
    font-size: 2.2em;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .conta--coopluz .papel__total strong { color: var(--papel-credito); }
  .papel__miudo {
    margin: var(--e-2) 0 0;
    padding-top: var(--e-1);
    border-top: 1px solid var(--papel-linha);
    font-size: 0.74em;
    color: var(--papel-tinta-2);
  }

  /* No celular as contas têm ~170px de largura: a tabela inteira ficaria em
     letra de 9px. Some da VISTA (continua para o leitor de tela) e fica só o
     que conta a história: cabeçalho, a linha de crédito e o total. */
  @media (max-width: 759px) {
    .papel__rubrica,
    .papel__historico,
    .papel__miudo {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .conta--hoje .papel__total { margin-top: var(--e-6); }
  }

  /* --- a diferença -------------------------------------------------------- */
  .fatura__diferenca { grid-column: 1 / -1; margin-top: var(--e-8); }
  @media (min-width: 760px) {
    .fatura__diferenca {
      grid-column: auto;
      align-self: center;
      margin-top: 0;
      padding-left: clamp(var(--e-4), 4vw - 1rem, var(--e-12));
    }
  }
  .fatura__menos { margin: 0; color: var(--mesa-verde); }
  .fatura__menos b {
    display: block;
    font-family: var(--display);
    font-variation-settings: "wght" 900;
    font-weight: 900;
    font-size: 3rem;
    line-height: 0.9;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  /* Na terceira coluna o número divide espaço com as duas contas: num tablet
     de 820 sobram ~160px, e a 3rem ele estourava a coluna. */
  @media (min-width: 760px) {
    .fatura__menos b { font-size: clamp(2.4rem, 0.6rem + 3.6vw, 4.4rem); }
  }
  .fatura__menos span { display: block; margin-top: var(--e-2); font-weight: 600; color: var(--mesa-tinta-2); }
  .fatura__outras { margin: var(--e-6) 0 0; max-width: 34ch; font-size: var(--t-sm); color: var(--mesa-tinta-2); }
  .fatura__outras b { color: var(--mesa-tinta); }

  /* --- a linha do tempo --------------------------------------------------- */
  .fatura__linha {
    --no: 14px;
    position: relative;
    display: grid;
    gap: var(--e-6);
    margin: var(--e-12) 0 0;
    padding: 0 0 0 calc(var(--no) + var(--e-4));
    list-style: none;
  }
  /* O trilho apagado e o fio verde por cima. O fio cresce por `scale` a partir
     da ponta "hoje" — no celular de cima para baixo, no desktop da esquerda. */
  .fatura__linha::before,
  .fatura__linha::after {
    content: "";
    position: absolute;
    left: calc(var(--no) / 2 - 1.5px);
    top: 4px;
    bottom: 4px;
    width: 3px;
    border-radius: 2px;
    background: var(--mesa-apagado);
  }
  .fatura__linha::after { background: var(--mesa-verde); transform-origin: top; }
  .fatura__linha li { position: relative; font-size: var(--t-sm); color: var(--mesa-tinta-2); }
  .fatura__linha li::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: 2px;
    left: calc(-1 * (var(--no) + var(--e-4)));
    width: var(--no);
    height: var(--no);
    border-radius: 50%;
    background: var(--mesa-verde);
    box-shadow: 0 0 0 4px var(--mesa);
  }
  .fatura__linha small {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mesa-verde);
  }
  .fatura__linha h3 {
    margin: var(--e-1) 0 var(--e-1);
    font-size: var(--t-md);
    color: var(--mesa-tinta);
  }
  .fatura__linha p { margin: 0; }

  @media (min-width: 900px) {
    .fatura__linha {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--e-8);
      margin-top: var(--e-12);
      padding: calc(var(--no) + var(--e-6)) 0 0;
    }
    .fatura__linha::before,
    .fatura__linha::after {
      left: 4px;
      right: 4px;
      top: calc(var(--no) / 2 - 1.5px);
      bottom: auto;
      width: auto;
      height: 3px;
    }
    .fatura__linha::after { transform-origin: left; }
    .fatura__linha li::before { top: calc(-1 * (var(--no) + var(--e-6))); left: 0; }
  }
</style>

<style>
  /* =======================================================================
     COREOGRAFIA — um verbo só: a conta nova CHEGA.
     Três primitivas, as mesmas que a página já gasta (opacidade, escala,
     giro). O estado natural do HTML é o FINAL (data-conta="coopluz"): sem JS,
     sem movimento ou com o script falhando, a mesa está composta.

     · entrada  — quando a mesa aparece, o fio da linha do tempo corre da
                  ponta "hoje" até "até 90 dias", cada nó acende ao ser
                  alcançado e a conta nova cai em cima da velha; o carimbo
                  bate por último e a diferença em reais aparece. ~2,4s, uma
                  vez por chegada (recomeça se a mesa sair bem da tela).
     · scroll   — AUSENTE por declaração: a rolagem só dispara a entrada. A
                  dona pediu, na seção de cima, que o movimento "passe sem
                  precisar rolar"; amarrar a mesa à rolagem era o que fazia a
                  seção anterior ocupar três telas.
     · ponteiro — o interruptor (a lâmpada da marca) troca as duas contas; e
                  passar sobre um passo marca no papel a parte que ele descreve.
     · transição— a troca do interruptor usa as mesmas transições da entrada,
                  ao contrário e sem atraso.
     ======================================================================= */

  .conta--coopluz,
  .papel__carimbo,
  .fatura__menos,
  .fatura__linha::after,
  .fatura__linha li::before {
    transition-property: opacity, scale, rotate;
    transition-duration: var(--dur-base);
    transition-timing-function: var(--ease-saida);
  }

  /* --- estado "hoje": antes da adesão ------------------------------------ */
  [data-conta="hoje"] .conta--coopluz { opacity: 0; scale: 1.06; rotate: 9deg; }
  [data-conta="hoje"] .papel__carimbo { opacity: 0; scale: 1.5; rotate: -14deg; }
  [data-conta="hoje"] .fatura__menos { opacity: 0; }
  [data-conta="hoje"] .fatura__linha::after { scale: 1 0; }
  [data-conta="hoje"] .fatura__linha li:not(:first-child)::before { scale: 0.55; opacity: 0.35; }
  @media (min-width: 900px) {
    [data-conta="hoje"] .fatura__linha::after { scale: 0 1; }
  }

  /* --- chegando em "coopluz": a sequência --------------------------------
     O fio leva 1.4s; cada nó acende quando o fio passa por ele (0, ⅓, ⅔, 1).
     A conta cai quando o fio chega no fim, o carimbo bate logo depois. */
  [data-conta="coopluz"] .fatura__linha::after {
    transition-duration: 1400ms;
    transition-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
  }
  [data-conta="coopluz"] .fatura__linha li::before { transition-duration: 300ms; transition-timing-function: var(--ease-mola); }
  [data-conta="coopluz"] .fatura__linha li:nth-child(2)::before { transition-delay: 460ms; }
  [data-conta="coopluz"] .fatura__linha li:nth-child(3)::before { transition-delay: 930ms; }
  [data-conta="coopluz"] .fatura__linha li:nth-child(4)::before { transition-delay: 1400ms; }
  [data-conta="coopluz"] .conta--coopluz {
    transition-duration: var(--dur-cena);
    transition-timing-function: var(--ease-cena);
    transition-delay: 1250ms;
  }
  [data-conta="coopluz"] .papel__carimbo {
    transition-duration: 260ms;
    transition-timing-function: var(--ease-saida);
    transition-delay: 1900ms;
  }
  [data-conta="coopluz"] .fatura__menos {
    transition-duration: 500ms;
    transition-delay: 2100ms;
  }

  /* --- ponteiro: o passo marca a parte do papel -------------------------- */
  /* O passo 1 marca o cabeçalho inteiro, e não só o carimbo: o carimbo já tem
     transição própria com atraso, e o realce herdaria os 1.9s dele. */
  @media (hover: hover) {
    .conta--coopluz .papel__topo,
    .papel__historico,
    .papel__credito th,
    .papel__credito td,
    .conta--coopluz .papel__total {
      transition: background-color var(--dur-instante) var(--curva);
    }
    .fatura:has(.fatura__linha > li:nth-child(1):hover) .conta--coopluz .papel__topo,
    .fatura:has(.fatura__linha > li:nth-child(2):hover) .papel__historico,
    .fatura:has(.fatura__linha > li:nth-child(3):hover) .papel__credito th,
    .fatura:has(.fatura__linha > li:nth-child(3):hover) .papel__credito td,
    .fatura:has(.fatura__linha > li:nth-child(4):hover) .conta--coopluz .papel__total {
      /* Marca-texto verde, e não o --papel-marcado: creme sobre creme não se
         via no quadro. Medido: tinta 11.70, crédito 4.60, tinta-2 4.94. */
      background-color: var(--papel-realce);
    }
  }

  /* --- o piso ------------------------------------------------------------ */
  @media (prefers-reduced-motion: reduce) {
    .conta--coopluz,
    .papel__carimbo,
    .fatura__menos,
    .fatura__linha::after,
    .fatura__linha li::before { transition: none !important; }
  }
</style>

<script>
  /* A mesa toca sozinha ao aparecer, e a lâmpada troca as contas.
     Dois observadores com papéis separados: LONGE arma a cena (volta para
     "hoje") enquanto a mesa está a mais de 200px fora da tela, então a troca
     acontece onde ninguém vê; PERTO dispara a chegada quando metade da mesa
     está visível. Quem clica no interruptor desliga o automático de vez: a
     página não briga com a escolha de quem lê. Com movimento reduzido não há
     automático — a mesa fica no estado final e o interruptor troca seco. */
  const secao = document.querySelector<HTMLElement>(".fatura");
  const mesa = secao?.querySelector(".fatura__mesa");

  if (secao && mesa) {
    const botoes = [...secao.querySelectorAll<HTMLButtonElement>("[data-ver]")];
    let escolheu = false;
    let espera = 0;

    const mostrar = (conta: string) => {
      secao.dataset.conta = conta;
      for (const b of botoes) b.setAttribute("aria-pressed", String(b.dataset.ver === conta));
    };

    for (const b of botoes) {
      b.addEventListener("click", () => {
        escolheu = true;
        clearTimeout(espera);
        mostrar(b.dataset.ver ?? "coopluz");
      });
    }

    const parado = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!parado && "IntersectionObserver" in window) {
      new IntersectionObserver(
        ([e]) => { if (!e.isIntersecting && !escolheu) { clearTimeout(espera); mostrar("hoje"); } },
        { rootMargin: "200px 0px" },
      ).observe(mesa);

      new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting && !escolheu && secao.dataset.conta === "hoje") {
            espera = window.setTimeout(() => { if (!escolheu) mostrar("coopluz"); }, 300);
          }
        },
        { threshold: 0.5 },
      ).observe(mesa);
    }
  }
</script>
