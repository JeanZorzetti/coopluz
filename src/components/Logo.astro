---
/* Gerado por logos/gerar-marca.py — nao editar a mao, rode o script.
   Inline em vez de <img>: assim o gradiente le tokens da propria pagina e a
   marca acompanha o tema, inclusive o seletor manual (data-tema), que um .svg
   externo nao enxerga. */
interface Props { size?: number; class?: string }
const { size = 40, class: klass } = Astro.props;
---

<svg
  class:list={["logo", klass]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role="img"
  aria-label="Coopluz"
  focusable="false"
>
  <defs>
    <linearGradient id="lg" gradientUnits="userSpaceOnUse" x1="24" y1="2" x2="62" y2="99"><stop offset="0.0" style="stop-color:var(--lg-0)"/><stop offset="0.58" style="stop-color:var(--lg-1)"/><stop offset="1.0" style="stop-color:var(--lg-2)"/></linearGradient>
  </defs>
  <g fill="none" stroke="url(#lg)" stroke-width="9.5" stroke-linecap="round" stroke-linejoin="round"><path d="M75.16 25.16A30 30 0 0 1 72.47 61.38A30 30 0 0 1 36.85 68.46A30 30 0 0 1 20.5 36.03A30 30 0 0 1 47.39 11.61"/></g><g fill="none" stroke="url(#lg)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"><path d="M41 78.5H59"/><path d="M44.25 85.5H55.75"/><path d="M46 92Q50 95.1 54 92"/></g><path fill="url(#lg)" fill-rule="evenodd" d="M37.04 53.46A18.75 18.75 0 0 1 58.96 31.54A18.75 18.75 0 0 1 37.04 53.46ZM40.22 50.28Q49.03 44.59 54.72 35.78Q46.9 42.46 40.22 50.28Z"/>
</svg>

<style>
  /* Valores claros crus: e o que sobra se light-dark() nao existir — o bloco
     do @supports cai fora e a marca fica na versao clara. */
  .logo {
    --lg-0: #40ac68;
    --lg-1: #248ca0;
    --lg-2: #1c68b4;

    display: block;
  }

  @supports (color: light-dark(#fff, #000)) {
    .logo {
      --lg-0: light-dark(#40ac68, #6fd394);
      --lg-1: light-dark(#248ca0, #4fbcd0);
      --lg-2: light-dark(#1c68b4, #5fa3e8);
    }
  }
</style>
