---
import { ATENDIMENTO, COOPERATIVA, EMPRESA, SITE, enderecoLinha, whatsapp } from "../consts";
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container rodape__grade">
    <div>
      <p class="rodape__marca">{SITE.nome}</p>
      <p class="rodape__texto">
        Energia por compensação na área da Equatorial Goiás. {SITE.papel} da cooperativa {COOPERATIVA.nome},
        atendendo desde {EMPRESA.fundacao}.
      </p>
    </div>

    <nav aria-label="Navegue">
      <h2 class="rodape__titulo">Navegue</h2>
      <ul class="rodape__links" role="list">
        <li><a href="/">Início</a></li>
        <li><a href="/parceiro">Seja parceiro</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
    </nav>

    <nav aria-label="Institucional">
      <h2 class="rodape__titulo">Institucional</h2>
      <ul class="rodape__links" role="list">
        <li><a href="/sobre">Quem somos</a></li>
        <li><a href="/privacidade">Privacidade</a></li>
        <li><a href="/termos">Termos de uso</a></li>
        <li>
          <a class="externo" href={whatsapp("Olá! Vim pelo site da Coopluz.")} target="_blank" rel="noopener">
            Falar no WhatsApp<span class="visualmente-oculto"> — abre em nova aba</span>
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="rodape__titulo">Atendimento</h2>
      <address class="rodape__texto">
        {enderecoLinha}<br />
        Atendimento {ATENDIMENTO.horarioCurto}<br />
        <a href={`tel:${EMPRESA.telefone}`}>{EMPRESA.telefoneExibicao}</a><br />
        <a href={`mailto:${EMPRESA.email}`}>{EMPRESA.email}</a>
      </address>
      <ul class="rodape__redes" role="list">
        <li><a href={EMPRESA.redes[0]} rel="me noopener">Instagram</a></li>
        <li><a href={EMPRESA.redes[1]} rel="me noopener">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="container rodape__base">
    <div class="rodape__linha">
      <p>© {ano} {EMPRESA.nomeLegal}. CNPJ e condições contratuais disponíveis sob solicitação.</p>

    </div>
    {/* FR-013: quem opera o site, dito por extenso, e o caminho para o canal
         oficial da cooperativa. Não é disclaimer defensivo — é a informação
         que a pessoa precisa para saber com quem está falando antes de mandar
         o WhatsApp dela. Fica ACIMA do aviso contratual porque é a mais
         importante das duas. */}
    <p class="rodape__aviso">
      Este site é operado por {EMPRESA.nomeLegal}, {SITE.papel.toLowerCase()} da {COOPERATIVA.nome} —
      não é o canal oficial da cooperativa. A {COOPERATIVA.nome} é uma {COOPERATIVA.descricao.toLowerCase()}
      independente, com sede em {COOPERATIVA.endereco.cidade}/{COOPERATIVA.endereco.uf}, e atende pelo site{" "}
      <a class="externo" href={COOPERATIVA.site} target="_blank" rel="noopener">
        {COOPERATIVA.site.replace(/^https?:\/\//, "")}<span class="visualmente-oculto"> — abre em nova aba</span>
      </a>.
    </p>
    <p class="rodape__aviso">
      Cotação, cadastro e adesão estão sujeitos a análise da cooperativa {COOPERATIVA.nome}. As condições
      apresentadas aqui não substituem o termo de adesão formal.
    </p>
  </div>
</footer>

<style>
  .rodape {
    background: var(--superficie-marca);
    color: var(--texto-sobre-marca);
    padding-block: var(--e-16) var(--e-8);
  }
  .rodape__grade {
    display: grid;
    gap: var(--e-8);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .rodape__marca {
    color: var(--texto-invertido);
    font-family: var(--display);
    font-variation-settings: "wght" 700;
    font-size: var(--t-lg);
    letter-spacing: -0.02em;
    margin-bottom: var(--e-2);
  }
  .rodape__titulo { color: var(--texto-invertido); font-size: var(--t-sm); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--e-4); }
  .rodape__texto { font-size: var(--t-sm); font-style: normal; line-height: 1.7; }
  .rodape__links, .rodape__redes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e-2); font-size: var(--t-sm); }
  .rodape__redes { margin-top: var(--e-4); grid-auto-flow: column; justify-content: start; gap: var(--e-4); }
  .rodape a { color: var(--link-sobre-marca); }
  .rodape a:hover { color: var(--texto-invertido); }
  .rodape__base {
    margin-top: var(--e-12);
    padding-top: var(--e-6);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: var(--t-sm);
  }
  .rodape__aviso { color: var(--texto-sobre-marca-suave); max-width: 78ch; }
  .rodape__aviso + .rodape__aviso { margin-top: var(--e-3); }

  /* O seletor de tema saiu daqui: virou o cordão do cabeçalho
     (Header.astro), onde a metáfora da lâmpada funciona. Esta linha voltou a
     ter um item só, então `space-between` não tem mais o que separar — mas
     fica, porque o `flex-wrap` continua sendo o que segura o © a 360px. */
  .rodape__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
  }
</style>

<script>
  // Delegado no documento porque o link "Chamar no WhatsApp" existe em vários
  // componentes (cabeçalho, rodapé, formulário) — um listener por lugar
  // duplicaria a mesma linha várias vezes.
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="https://wa.me/"]');
    if (a) (window as any).gtag?.("event", "clique_whatsapp", { pagina: location.pathname });
  });
</script>
