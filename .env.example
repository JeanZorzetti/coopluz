# Postgres do EasyPanel — o MESMO banco do hub autogestor (mesma connection
# string). Não é um banco novo: os leads deste site caem nas mesmas tabelas
# crm_leads/crm_eventos que o painel administrativo do hub já lê, no
# pipeline "coopluz" ou "parceiro-coopluz". Sem isso o /api/lead responde 503
# e o formulário mostra o WhatsApp — nunca engole o lead em silêncio.
DATABASE_URL=postgres://usuario:senha@host:5432/autogestor?sslmode=require

# URL pública deste site (domínio próprio, não o do hub).
SITE_URL=https://coopluz.roilabs.com.br

# ATENÇÃO no desenvolvimento local: o Astro carrega .env para `import.meta.env`,
# NÃO para `process.env` — e o código lê `process.env` porque é isso que a Vercel
# fornece em runtime. Copiar este arquivo para .env não basta localmente; exporte
# a variável antes de subir o dev:
#
#   export DATABASE_URL="postgres://..." && npm run dev
#
# Na Vercel não há nada a fazer: as variáveis do projeto já chegam em process.env.
